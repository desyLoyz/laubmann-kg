%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#F7F8F4", "primaryBorderColor": "#7E8C82", "primaryTextColor": "#1D2A21", "lineColor": "#5F6E64", "clusterBkg": "#EEF1EA", "clusterBorder": "#C9D2C7", "fontFamily": "Segoe UI, system-ui, sans-serif", "fontSize": "14px"}}}%%
classDiagram
    direction TB

    class ArchivalUnit {
        <<abstract · rico:Record>>
    }
    class EntryRecord {
        <<abstract · prov:Entity>>
        dcterms:isPartOf · prov:wasDerivedFrom → entry
    }
    class RecordDetail {
        <<abstract>>
        dcterms:isPartOf → record
    }

    class DiaryVolume {
    }
    class DiaryPage {
        dcterms:identifier
    }
    class DiaryEntry {
        <<dwc:Event>>
        dwc:eventDate · dwc:verbatimEventDate
        dwc:fieldNotes
        entryKind · datePlausible · skos:note
    }
    class SourceRegion {
    }

    class Observation {
        <<dwc:Occurrence>>
        verbatimNotes
        recordType field | third-party | literature
        dwc:occurrenceStatus present | absent
        dwc:individualCount ≥0 · individualCountMin · Max
        countQualifier
        dwc:sex · dwc:lifeStage · dwc:vitality
        breedingEvidence · dwc:reproductiveCondition
        movementKind · flightDirection
        dwc:behavior · dwc:habitat
        dwc:identificationQualifier
        dwc:eventDate · dwc:eventTime · timeOfDay · daylightPhase
        spatialContext · microhabitat · relativeElevation
        observationRadiusMeters · dwc:coordinateUncertaintyInMeters
        spatialConfidence · dwc:samplingProtocol
        dwc:basisOfRecord
    }
    class Vocalisation {
        callType
        callTranscription
    }
    class TravelEvent {
        <<dwc:Event>>
    }
    class TravelLeg {
        transportMode
        departureTime · arrivalTime
    }
    class WeatherReport {
        weatherVerbatim
        temperatureValue · temperatureUnit
        precipitation · skyCondition · wind
    }

    class Taxon {
        <<dwc:Taxon>>
        dwc:vernacularName · dwc:scientificName
        dwc:taxonRank · isBird
        dwc:kingdom … dwc:genus
        matchMethod · matchConfidence · gbifMatchType
        dwc:taxonID
    }
    class Place {
        <<geo:SpatialThing · dcterms:Location>>
        rdfs:label · dwc:verbatimLocality
        placeKind
        geo:lat · geo:long · gsp:asWKT
    }
    class Person {
        <<schema:Person>>
        schema:name
    }
    class HabitatConcept {
        <<skos:Concept · lkg:habitatScheme>>
        skos:prefLabel
    }
    class EvidenceKind {
        <<skos:Concept · lkg:evidenceKindScheme>>
        visual | auditory | nest | specimen
    }

    class ExtractionRun {
        <<prov:Activity>>
        prov:startedAtTime
    }
    class SoftwareAgent {
        <<prov:SoftwareAgent>>
        model · backend
    }
    class Prompt {
        <<prov:Entity>>
        sha256
    }

    class GBIF_Species {
        gbif.org/species/KEY
    }
    class Wikidata_Item {
        wikidata.org/entity/Q…
    }

    ArchivalUnit <|-- DiaryVolume
    ArchivalUnit <|-- DiaryPage
    ArchivalUnit <|-- DiaryEntry
    ArchivalUnit <|-- SourceRegion
    EntryRecord <|-- Observation
    EntryRecord <|-- TravelEvent
    EntryRecord <|-- WeatherReport
    RecordDetail <|-- Vocalisation
    RecordDetail <|-- TravelLeg

    DiaryPage --> "1" DiaryVolume : dcterms∶isPartOf
    DiaryEntry --> "1" DiaryPage : dcterms∶isPartOf
    SourceRegion --> "0..1" DiaryPage : dcterms∶isPartOf
    DiaryEntry --> "0..1" SourceRegion : hasSourceRegion
    DiaryEntry --> "0..1" Place : entryPlace
    DiaryEntry --> "*" Observation : containsObservation ⊑ dcterms∶hasPart
    DiaryEntry --> "*" TravelEvent : containsTravelEvent ⊑ dcterms∶hasPart
    DiaryEntry --> "*" WeatherReport : hasWeather ⊑ dcterms∶hasPart
    DiaryEntry --> "*" Person : mentionsPerson · mentionsCompanion | Source | Collector | CitedAuthor | Other

    Observation --> "1" Taxon : observedTaxon ⊑ dwciri∶toTaxon
    Observation --> "0..1" Place : observedAt
    Observation --> "0..1" Place : hasLocality (own place)
    Observation --> "0..1" Person : dwciri∶recordedBy
    Observation --> "0..4" EvidenceKind : evidenceKind
    Observation --> "*" Vocalisation : hasVocalisation ⊑ dcterms∶hasPart
    Observation --> "0..1" HabitatConcept : dwciri∶habitat
    Observation --> "1" ExtractionRun : prov∶wasGeneratedBy

    TravelEvent --> "1..*" TravelLeg : hasLeg ⊑ dcterms∶hasPart
    TravelLeg --> "1..*" Place : departurePlace · arrivalPlace · viaPlace
    ExtractionRun --> "1" SoftwareAgent : prov∶wasAssociatedWith
    ExtractionRun --> "1" Prompt : prov∶used

    Taxon --> "0..1" GBIF_Species : skos∶exactMatch · closeMatch · broadMatch
    Person --> "0..1" Wikidata_Item : owl∶sameAs

    cssClass "ArchivalUnit,EntryRecord,RecordDetail" abstract
    cssClass "DiaryVolume,DiaryPage,SourceRegion" source
    cssClass "DiaryEntry,Observation" hub
    cssClass "Vocalisation,TravelEvent,TravelLeg,WeatherReport" detail
    cssClass "Taxon,Place,Person" entity
    cssClass "HabitatConcept,EvidenceKind" concept
    cssClass "ExtractionRun,SoftwareAgent,Prompt" prov
    cssClass "GBIF_Species,Wikidata_Item" ext
    classDef abstract fill:#FBFBF9,stroke:#7E8C82,stroke-width:1px,stroke-dasharray:3 3,color:#5F6E64,font-style:italic
    classDef hub fill:#DDEBDF,stroke:#2F6B45,stroke-width:3px,color:#14261B
    classDef entity fill:#E2EBF5,stroke:#35608A,stroke-width:2px,color:#14263A
    classDef detail fill:#F7F8F4,stroke:#7E8C82,stroke-width:1px,color:#1D2A21
    classDef concept fill:#F3EEF7,stroke:#6E5A8A,stroke-width:1px,color:#2E2340
    classDef source fill:#F1ECE0,stroke:#8A7A5A,stroke-width:1px,color:#3A3020
    classDef prov fill:#EEEFEC,stroke:#8A8F8B,stroke-width:1px,stroke-dasharray:5 4,color:#3B413D
    classDef ext fill:#FFFFFF,stroke:#35608A,stroke-width:1px,stroke-dasharray:6 4,color:#14263A
