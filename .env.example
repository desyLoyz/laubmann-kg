# LLM provider credentials — loaded from this file into the process environment
# (existing env vars are not overwritten). The pipeline reads GOOGLE_API_KEY
# (or GEMINI_API_KEY) only; GBIF, Wikidata, Nominatim and the GeoNames dumps
# need no key.
GOOGLE_API_KEY=

# Optional overrides
LAUBMANN_KG_CONFIG=configs/pipeline.yaml
LAUBMANN_KG_LOG_LEVEL=INFO
