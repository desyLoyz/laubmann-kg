    vcard:hasEmail <mailto:alois.wieshuber@gda.bayern.de> .

# =============================================================
# CLASSES
# =============================================================

# --- Grouping classes (hierarchy; not materialised in the data) --------------

lkg:ArchivalUnit
    a owl:Class ;
    rdfs:label "Archival Unit"@en , "Archivalische Einheit"@de ;
    rdfs:comment "A unit of the digitised source: a diary volume, a scanned page, a dated entry or a layout region on a page (body text or multimodal). Grouping class only (not asserted as rdf:type in the data); the units are connected by dcterms:isPartOf (region → page → volume, entry → page). In Records in Contexts terms a volume is a Record and the others are parts of it."@en ;
    rdfs:subClassOf rico:RecordResource .

lkg:EntryRecord
    a owl:Class ;
    rdfs:label "Entry Record"@en , "Eintragsdatensatz"@de ;
    rdfs:comment "Anything the extraction model reads out of one diary entry: an Observation, a TravelEvent, a TravelLeg or a WeatherReport. Every entry record is prov:wasDerivedFrom exactly one DiaryEntry and prov:wasGeneratedBy the extraction run; it is dcterms:isPartOf that entry (a TravelLeg: of its TravelEvent). Grouping class only (not asserted as rdf:type in the data). Since 0.6.0 there is no separate 'record detail' level: vocalisations are properties of the Observation, travel legs are entry records."@en ;
    rdfs:subClassOf prov:Entity .

# --- Archival units ---------------------------------------------------------

lkg:DiaryVolume
    a owl:Class ;
    rdfs:label "Diary Volume"@en , "Tagebuchband"@de ;
    rdfs:comment "A single bound volume of the field journal (34 volumes, 1917–1965); dcterms:temporal gives the span its title page names (\"YYYY-MM/YYYY-MM\")."@en ;
    rdfs:subClassOf lkg:ArchivalUnit , rico:Record .

lkg:DiaryPage
    a owl:Class ;
    rdfs:label "Diary Page"@en , "Tagebuchseite"@de ;
    rdfs:comment "A scanned page of a volume; dcterms:isPartOf links it to its DiaryVolume."@en ;
    rdfs:subClassOf lkg:ArchivalUnit , rico:RecordPart .

lkg:DiaryEntry
    a owl:Class ;
    rdfs:label "Diary Entry"@en , "Tagebucheintrag"@de ;
    rdfs:comment "The primary semantic unit: a dated, located entry written by the observer — the diarist's day. The node stands both for the text (a part of the volume) and for the day it records: it is the Darwin Core Event (dwc:eventDate, dwc:verbatimEventDate, dwc:verbatimLocality, dwc:fieldNotes; its IRI is the eventID of the DwC-A) and dcterms:hasPart its observations, travel events and weather report. dcterms:isPartOf its DiaryPage (or the volume when the page is unknown)."@en ;
    rdfs:subClassOf lkg:ArchivalUnit , rico:RecordPart , dwc:Event .

lkg:SourceRegion
    a owl:Class ;
    rdfs:label "Source Region"@en , "Quellregion"@de ;
    rdfs:comment "A detected layout region on a scanned page (HistOrniGraph layout stage) that belongs to a diary entry; dcterms:isPartOf its DiaryPage. Asserted as lkg:SourceRegion for the body-text regions an entry's text was read from (an entry that runs over several pages has several), as lkg:MultimodalRegion for the pictorial, physical and inserted-text regions placed with the entry."@en ;
    rdfs:subClassOf lkg:ArchivalUnit , rico:RecordPart .

lkg:MultimodalRegion
    a owl:Class ;
    rdfs:label "Multimodal Region"@en , "multimodale Region"@de ;
    rdfs:comment "A non-body-text region of a page that belongs to a diary entry: a drawing or sketch map, a photograph or postcard, a printed illustration, a mounted object (feathers, pressed leaves, labels) or an inserted text (newspaper clipping, typed report, letter, caption, list). Taken from the cleaned multimodal catalogue v2 (images and objects linked to a dated entry; duplicate scans of the same page removed) and from the text-inserts catalogue (paragraphs and lists judged relevant; marginal notes excluded). Carries dcterms:type (DCMI type), lkg:regionKind, dcterms:description (the layout model's description of an image, English) and lkg:visibleText (text on the region as transcribed); dcterms:isPartOf its DiaryPage, reached from its entry via lkg:hasMultimodalRegion. It is the entry it sits in, not the observations, that the region belongs to: the diarist placed it with the day's notes."@en ;
    rdfs:subClassOf lkg:SourceRegion .

# --- Entry records ----------------------------------------------------------

lkg:Observation
    a owl:Class ;
    rdfs:label "Observation"@en , "Beobachtung"@de ;
    rdfs:comment "One taxon record read from a diary entry: a Darwin Core Occurrence (dwc:occurrenceStatus, dwc:individualCount, dwc:sex, dwc:lifeStage, dwc:eventDate, dwciri:recordedBy, dwciri:habitat …) plus the project detail (record type, count qualifier and range, breeding evidence, movement, evidence kinds, call type and transcription). An entry with several taxa has several Observations; the DiaryEntry is the event they belong to."@en ;
    rdfs:subClassOf lkg:EntryRecord , dwc:Occurrence .

lkg:TravelEvent
    a owl:Class ;
    rdfs:label "Travel Event"@en , "Reiseereignis"@de ;
    rdfs:comment "A journey of the diarist described in a diary entry, made of one or more TravelLegs (train, foot, boat …). Not a Darwin Core Event: the entry is the event, the journey a part of it."@en ;
    rdfs:subClassOf lkg:EntryRecord .

lkg:WeatherReport
    a owl:Class ;
    rdfs:label "Weather Report"@en , "Wetterbericht"@de ;
    rdfs:comment "Weather as recorded in the diary entry (at most one report per entry). The verbatim wording (lkg:weatherVerbatim) is primary; structured values are optional normalisations and never unit-converted (historical entries may use Réaumur)."@en ;
    rdfs:subClassOf lkg:EntryRecord .

lkg:TravelLeg
    a owl:Class ;
    rdfs:label "Travel Leg"@en , "Reiseabschnitt"@de ;
    rdfs:comment "A single segment of a journey (one train leg, one walking leg …); dcterms:isPartOf its TravelEvent, prov:wasDerivedFrom the entry."@en ;
    rdfs:subClassOf lkg:EntryRecord .

# --- Shared referents -------------------------------------------------------

lkg:Taxon
    a owl:Class ;
    rdfs:label "Taxon"@en , "Taxon"@de ;
    rdfs:comment "A biological taxon (species, genus, family or informal group) observed or mentioned, keyed by the German vernacular name as the diarist wrote it (dwc:vernacularName; further spellings merged by entity resolution as skos:altLabel). Resolved names carry dwc:scientificName, dwc:taxonRank, the GBIF backbone link (skos:exactMatch / closeMatch / broadMatch to an authority record in lkg:authority_gbif; mirrored as the Darwin Core literal dwc:taxonID) and the GBIF higher classification (dwc:kingdom … dwc:genus)."@en ;
    rdfs:subClassOf dwc:Taxon .

lkg:Place
    a owl:Class ;
    rdfs:label "Place"@en , "Ort"@de ;
    rdfs:comment "A named location shared by every entry, record and journey that names it: a settlement, a named site or a region (lkg:placeKind). rdfs:label is the modern name, merged spellings are skos:altLabel; the wording of a particular use stays on that use (dwc:verbatimLocality of the entry or observation). Georeferenced places carry geo:lat/geo:long, dwc:decimalLatitude/Longitude, dwc:coordinateUncertaintyInMeters (centroid radius), a gsp:hasGeometry point, and link to their GeoNames feature and Wikidata item (skos:exactMatch / closeMatch, authority schemes lkg:authority_geonames, lkg:authority_wikidata); a stated elevation is dwc:minimumElevationInMeters / dwc:maximumElevationInMeters. Habitats are NOT places: they are skos:Concepts in lkg:habitatScheme."@en ;
    rdfs:subClassOf geo:SpatialThing , dcterms:Location , gsp:Feature .

lkg:Person
    a owl:Class ;
    rdfs:label "Person"@en , "Person"@de ;
    rdfs:comment "A person mentioned in the diary (companion, source, collector, cited author) or recorded as observer (dwciri:recordedBy). The role is carried on the mention edge (sub-properties of lkg:mentionsPerson), not on the shared Person node. Name variants merged by entity resolution (\"W. Wüst\", \"Wüst\" → \"Walter Wüst\") are skos:altLabels. Linked persons carry skos:exactMatch / closeMatch to their Wikidata item and GND record (lkg:authority_wikidata, lkg:authority_gnd)."@en ;
    rdfs:subClassOf schema:Person .

# lkg:habitatScheme and all other skos:ConceptSchemes are declared in
# controlled_vocabularies.ttl. Habitat nodes in the data are skos:Concepts of
# lkg:habitatScheme, reached from Observations via dwciri:habitat.

# =============================================================
# PROPERTIES
# =============================================================

# --- Partonomy: entry → records (all ⊑ dcterms:hasPart) ---------------------
# The inverse dcterms:isPartOf is asserted on every child in the data.

lkg:containsObservation
    a owl:ObjectProperty ;
    rdfs:label "contains observation"@en , "enthält Beobachtung"@de ;
    rdfs:comment "Entry → one of its taxon records."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:Observation ;
    rdfs:subPropertyOf dcterms:hasPart .

lkg:containsTravelEvent
    a owl:ObjectProperty ;
    rdfs:label "contains travel event"@en , "enthält Reiseereignis"@de ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:TravelEvent ;
    rdfs:subPropertyOf dcterms:hasPart .

lkg:hasWeather
    a owl:ObjectProperty ;
    rdfs:label "has weather"@en , "hat Wetter"@de ;
    rdfs:comment "Entry → its weather report (at most one)."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:WeatherReport ;
    rdfs:subPropertyOf dcterms:hasPart .

lkg:hasLeg
    a owl:ObjectProperty ;
    rdfs:label "has leg"@en , "hat Etappe"@de ;
    rdfs:domain lkg:TravelEvent ;
    rdfs:range lkg:TravelLeg ;
    rdfs:subPropertyOf dcterms:hasPart .

lkg:hasSourceRegion
    a owl:ObjectProperty ;
    rdfs:label "has source region"@en , "hat Quellregion"@de ;
    rdfs:comment "Entry → a layout region on a scanned page that belongs to it (the region is dcterms:isPartOf its page). Asserted for every body-text region the entry's text was read from — an entry that continues over several pages has one per page — and, via the sub-property lkg:hasMultimodalRegion, for its multimodal regions."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:SourceRegion .

lkg:hasMultimodalRegion
    a owl:ObjectProperty ;
    rdfs:label "has multimodal region"@en , "hat multimodale Region"@de ;
    rdfs:comment "Entry → a drawing, map, photograph, postcard, mounted object or inserted text placed with it (the nearest preceding entry header in the page's reading order)."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:MultimodalRegion ;
    rdfs:subPropertyOf lkg:hasSourceRegion .

# --- Multimodal region ------------------------------------------------------
# Standard terms used on the region: dcterms:type (DCMI type: StillImage,
# PhysicalObject, Text), dcterms:description (the layout model's description,
# English), dcterms:identifier (the crop file: regions/<page_id>/<file>.png in
# the volume's HistOrniGraph output folder), schema:image (the public URL of the
# crop, emitted once the images are hosted: config multimodal.image_base_url),
# rdfs:label, dcterms:isPartOf.

lkg:regionKind
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:regionKindScheme ;
    rdfs:label "region kind"@en , "Regionsart"@de ;
    rdfs:comment "What a multimodal region shows: drawing, photograph, map, print, object, text-insert, list (lkg:regionKindScheme)."@en ;
    rdfs:domain lkg:MultimodalRegion ;
    rdfs:range xsd:string .

lkg:visibleText
    a owl:DatatypeProperty ;
    rdfs:label "visible text"@en , "sichtbarer Text"@de ;
    rdfs:comment "Text on a multimodal region as transcribed (caption, label, the text of a clipping or letter). Not part of any entry's dwc:fieldNotes and not read by the extraction model."@en ;
    rdfs:domain lkg:MultimodalRegion ;
    rdfs:range rdf:langString .

lkg:regionCompleteness
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:regionCompletenessScheme ;
    rdfs:label "region completeness"@en , "Vollständigkeit der Region"@de ;
    rdfs:comment "Whether the region's image shows its whole object (complete) or cuts it off (cut off: the object continues beyond the scanned page, e.g. a fold-out, or the layout box was too tight and the page shows no more of it). Set where two scan checks agree (lkg:regionCompletenessScheme); absent where they do not."@en ;
    rdfs:domain lkg:MultimodalRegion ;
    rdfs:range xsd:string .

# --- Entry-level reading ----------------------------------------------------
# Standard terms used on the entry (not redeclared here): dwc:eventDate
# (xsd:date, or "start/end" for multi-day entries), dwc:verbatimEventDate,
# dwc:verbatimLocality (the header's place wording), dwc:fieldNotes (the
# transcribed entry text, @de), skos:note (date, reading and filing notes),
# dcterms:identifier, dcterms:isPartOf.

lkg:entryPlace
    a owl:ObjectProperty ;
    rdfs:label "entry place"@en , "Eintragsort"@de ;
    rdfs:comment "The entry's main locality as read from the header/text. Observations without an own locality inherit it as their effective place (lkg:observedAt)."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:Place .

lkg:entryKind
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:entryKindScheme ;
    rdfs:label "entry kind"@en , "Eintragsart"@de ;
    rdfs:comment "Kind of diary entry: field-day, species-digest, retrospective, correspondence, other (lkg:entryKindScheme)."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range xsd:string .

lkg:datePlausible
    a owl:DatatypeProperty ;
    rdfs:label "date plausible"@en , "Datum plausibel"@de ;
    rdfs:comment "Extraction model's judgement whether the header date is consistent with the entry text. false = contradicted and not repairable (such entries are normally excluded by QA). The explanation is a skos:note on the entry."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range xsd:boolean .

# --- Persons: role on the mention edge --------------------------------------

lkg:mentionsPerson
    a owl:ObjectProperty ;
    rdfs:label "mentions person"@en , "erwähnt Person"@de ;
    rdfs:comment "Entry → a person it mentions. The role in this entry is expressed by the sub-property (companion, source, collector, cited author, other); the generic property is asserted alongside so consumers without inference see every mention."@en ;
    rdfs:domain lkg:DiaryEntry ;
    rdfs:range lkg:Person ;
    rdfs:subPropertyOf schema:mentions .

lkg:mentionsCompanion
    a owl:ObjectProperty ;
    rdfs:label "mentions companion"@en , "erwähnt Begleiter"@de ;
    rdfs:comment "The person accompanied the diarist in the field."@en ;
    rdfs:subPropertyOf lkg:mentionsPerson .

lkg:mentionsSource
    a owl:ObjectProperty ;
    rdfs:label "mentions source"@en , "erwähnt Gewährsperson"@de ;
    rdfs:comment "The person reported the information to the diarist (in person or by letter)."@en ;
    rdfs:subPropertyOf lkg:mentionsPerson .

lkg:mentionsCollector
    a owl:ObjectProperty ;
    rdfs:label "mentions collector"@en , "erwähnt Sammler"@de ;
    rdfs:comment "The person collected or shot the specimen."@en ;
    rdfs:subPropertyOf lkg:mentionsPerson .

lkg:mentionsCitedAuthor
    a owl:ObjectProperty ;
    rdfs:label "mentions cited author"@en , "erwähnt zitierten Autor"@de ;
    rdfs:comment "The person is the author of a publication the entry cites."@en ;
    rdfs:subPropertyOf lkg:mentionsPerson .

lkg:mentionsOther
    a owl:ObjectProperty ;
    rdfs:label "mentions other person"@en , "erwähnt sonstige Person"@de ;
    rdfs:comment "Mention with a role outside the four above."@en ;
    rdfs:subPropertyOf lkg:mentionsPerson .

# --- Observation ------------------------------------------------------------
# Standard terms used on the observation (not redeclared here):
# dwc:verbatimIdentification (taxon name as written when resolution merged it),
# dwc:occurrenceStatus, dwc:individualCount, dwc:sex, dwc:lifeStage,
# dwc:vitality, dwc:reproductiveCondition (confirmed breeding), dwc:behavior,
# dwc:habitat, dwciri:habitat, dwc:identificationQualifier, dwc:eventDate (own
# date or range, else the entry's date or interval), dwc:eventTime,
# dwc:verbatimLocality (own locality as written), dwc:minimumElevationInMeters /
# dwc:maximumElevationInMeters (stated elevation of its own site),
# dwc:occurrenceRemarks (reviewer notes), dwc:basisOfRecord, dwciri:recordedBy
# (the diarist and his companions, or the third-party observer; absent for an
# unattributed report or citation), dwc:associatedReferences, dcterms:isPartOf,
# prov:wasDerivedFrom, prov:wasGeneratedBy.

lkg:observedTaxon
    a owl:ObjectProperty ;
    rdfs:label "observed taxon"@en , "beobachtetes Taxon"@de ;
    rdfs:domain lkg:Observation ;
    rdfs:range lkg:Taxon ;
    rdfs:subPropertyOf dwciri:toTaxon .

lkg:observedAt
    a owl:ObjectProperty ;
    rdfs:label "observed at"@en , "beobachtet bei"@de ;
    rdfs:comment "The EFFECTIVE place of the record: its own locality when the text states one, otherwise the entry place. Use lkg:hasLocality to see whether the place was stated on the record itself."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range lkg:Place .

lkg:hasLocality
    a owl:ObjectProperty ;
    rdfs:label "has locality"@en , "hat eigene Örtlichkeit"@de ;
    rdfs:comment "The record's OWN locality when it differs from the entry place (its wording is co-emitted as dwc:verbatimLocality on the observation). Independent of lkg:observedAt: observedAt is the effective place, hasLocality the own-locality subset."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range lkg:Place .

lkg:recordType
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:recordTypeScheme ;
    rdfs:label "record type"@en , "Nachweistyp"@de ;
    rdfs:comment "Provenance category of the record: field-observation (the diarist's own sighting), third-party-report (reported to the diarist in person or by letter), literature-record (digested from a publication or card index) — lkg:recordTypeScheme. Deliberately NOT a sub-property of dwc:basisOfRecord (different value spaces); the derived basisOfRecord (HumanObservation / PreservedSpecimen / MaterialCitation) is emitted as dwc:basisOfRecord."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:evidenceKind
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:evidenceKindScheme ;
    rdfs:label "evidence kind"@en , "Belegart"@de ;
    rdfs:comment "How the organism was detected: visual (seen), auditory (heard), nest (nest, eggs or young found), specimen (collected or preserved) — the skos:notation of a concept in lkg:evidenceKindScheme, like every controlled value of the ontology. Only emitted when the text says how; an observation may have none or several. What was heard is on the same observation: lkg:callType and lkg:callTranscription."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:individualCountMin
    a owl:DatatypeProperty ;
    rdfs:label "individual count (minimum)"@en , "Individuenzahl (Minimum)"@de ;
    rdfs:comment "Lower bound of a stated range (\"3-4\" -> 3). A single stated number is dwc:individualCount."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:integer .

lkg:individualCountMax
    a owl:DatatypeProperty ;
    rdfs:label "individual count (maximum)"@en , "Individuenzahl (Maximum)"@de ;
    rdfs:comment "Upper bound of a stated range (\"3-4\" -> 4)."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:integer .

lkg:countQualifier
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:countQualifierScheme ;
    rdfs:label "count qualifier"@en , "Zahlenqualifikator"@de ;
    rdfs:comment "Qualifier for the count: exact, minimum (\"mindestens\", \"über\"), maximum (\"höchstens\", \"bis zu\"), approximate, plural-unspecified (lkg:countQualifierScheme)."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:breedingEvidence
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:breedingEvidenceScheme ;
    rdfs:label "breeding evidence"@en , "Brutnachweis"@de ;
    rdfs:comment "Atlas-style breeding evidence category: confirmed, probable, possible (lkg:breedingEvidenceScheme). confirmed is co-emitted as dwc:reproductiveCondition \"breeding\"."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:movementKind
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:movementKindScheme ;
    rdfs:label "movement kind"@en , "Bewegungsart"@de ;
    rdfs:comment "Kind of movement stated: migrating, passing-over, arriving, departing, resting, roosting (lkg:movementKindScheme)."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:flightDirection
    a owl:DatatypeProperty ;
    rdfs:label "flight direction"@en , "Flugrichtung"@de ;
    rdfs:comment "Flight direction as written by the diarist (\"NO→SW\"); free German text, not normalised."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range rdf:langString .

# --- Spatial and temporal detail stated in the text (0.5.0, tightened 0.7.0) ---

lkg:spatialContext
    a owl:DatatypeProperty ;
    rdfs:label "spatial context description"@en , "räumlicher Beobachtungskontext"@de ;
    rdfs:comment "The observer's vantage as written (e.g. 'vom Fenster meiner Wohnung', 'vom Zug aus', 'vom Beobachtungsschirm')."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range rdf:langString .

lkg:microhabitat
    a owl:DatatypeProperty ;
    rdfs:label "microhabitat"@en , "Mikrohabitat"@de ;
    rdfs:comment "Where on or in its habitat the bird was, as written (e.g. 'Baumkrone', 'Teichufer', 'Fenstersims', 'Telegraphendraht'). Distinct from the habitat type on dwc:habitat / dwciri:habitat."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range rdf:langString .

lkg:relativeElevation
    a owl:DatatypeProperty ;
    rdfs:label "relative elevation"@en , "relative Höhe / Flughöhe"@de ;
    rdfs:comment "Flight height above ground as written (e.g. 'in mäßiger Höhe', 'sehr hoch'). Absolute elevations are dwc:minimumElevationInMeters / dwc:maximumElevationInMeters."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range rdf:langString .





lkg:timeOfDay
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:timeOfDayScheme ;
    rdfs:label "time of day"@en , "Tageszeit"@de ;
    rdfs:comment "Qualitative time of day of the record, when stated: dawn, morning, forenoon, noon, afternoon, evening, dusk, night (lkg:timeOfDayScheme). A stated clock time is dwc:eventTime."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .


lkg:verbatimNotes
    a owl:DatatypeProperty ;
    rdfs:label "verbatim notes"@en , "Originalwortlaut"@de ;
    rdfs:comment "The diary passage the record was read from, German, unchanged. (dwc:occurrenceRemarks carries the model's remark on the record, dwc:fieldNotes on the entry the whole entry text.)"@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range rdf:langString .

# --- Vocalisation (on the Observation, since 0.6.0) ------------------------

lkg:callType
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:callTypeScheme ;
    rdfs:label "call type"@en , "Lautäußerungstyp"@de ;
    rdfs:comment "Type of vocalisation heard: song, call, alarm, drumming (lkg:callTypeScheme). Only when the text says which; an observation heard singing and calling has two values. Implies lkg:evidenceKind \"auditory\", which is always asserted alongside (an auditory record without a stated type has the evidence kind only). Replaces the lkg:Vocalisation node of 0.4–0.5 and the dwc:behavior copies (\"singend\", \"ruft\")."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

lkg:callTranscription
    a owl:DatatypeProperty ;
    rdfs:label "call transcription"@en , "Lautschrift"@de ;
    rdfs:comment "Phonetic rendering of the call as written in the diary (\"zich zich\", \"Tlü-hit\"). Only when the diarist wrote one (no placeholder); several values when he wrote several. With several call types and transcriptions on one observation, which transcription renders which type is not recorded (see lkg:verbatimNotes)."@en ;
    rdfs:domain lkg:Observation ;
    rdfs:range xsd:string .

# --- Travel -----------------------------------------------------------------

lkg:departurePlace
    a owl:ObjectProperty ;
    rdfs:label "departure place"@en , "Abfahrtsort"@de ;
    rdfs:comment "Where the leg started: as stated, else the previous leg's arrival, else the entry's own place when the leg leads elsewhere. Absent when nothing says where a leg to the entry's own place began (0.6.0: no departure is invented)."@en ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range lkg:Place .

lkg:arrivalPlace
    a owl:ObjectProperty ;
    rdfs:label "arrival place"@en , "Ankunftsort"@de ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range lkg:Place .

lkg:viaPlace
    a owl:ObjectProperty ;
    rdfs:label "via place"@en , "über Ort"@de ;
    rdfs:comment "Intermediate place named on the leg (station passed, place walked through)."@en ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range lkg:Place .

lkg:departureTime
    a owl:DatatypeProperty ;
    rdfs:label "departure time"@en , "Abfahrtszeit"@de ;
    rdfs:comment "Entry date combined with the stated clock time."@en ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range xsd:dateTime .

lkg:arrivalTime
    a owl:DatatypeProperty ;
    rdfs:label "arrival time"@en , "Ankunftszeit"@de ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range xsd:dateTime .

lkg:transportMode
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:transportModeScheme ;
    rdfs:label "transport mode"@en , "Verkehrsmittel"@de ;
    rdfs:comment "How the leg was travelled, when stated: train, foot, boat, car, carriage, bicycle (lkg:transportModeScheme)."@en ;
    rdfs:domain lkg:TravelLeg ;
    rdfs:range xsd:string .

# --- Place ------------------------------------------------------------------
# Standard terms used on the place: rdfs:label (modern name), skos:altLabel
# (merged spellings), geo:lat / geo:long, dwc:decimalLatitude /
# dwc:decimalLongitude, dwc:geodeticDatum, gsp:hasGeometry (→ gsp:Geometry with
# gsp:asWKT "POINT(lon lat)"^^gsp:wktLiteral), dwc:coordinateUncertaintyInMeters
# (centroid radius), dwc:georeferenceSources, dwc:minimumElevationInMeters /
# dwc:maximumElevationInMeters (stated elevation), and the authority links
# (skos:exactMatch / closeMatch → GeoNames feature, Wikidata item).

lkg:placeKind
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:placeKindScheme ;
    rdfs:label "place kind"@en , "Ortsart"@de ;
    rdfs:comment "settlement (town, village, district), locality (a named site: lake, moor, mountain, hut, park, station) or region (landscape, valley, mountain range) — lkg:placeKindScheme; absent when not read."@en ;
    rdfs:domain lkg:Place ;
    rdfs:range xsd:string .

# --- Taxon ------------------------------------------------------------------
# Standard terms used on the taxon: rdfs:label + dwc:vernacularName (German, as
# written), dwc:scientificName, dwc:taxonRank, dwc:taxonID, dwc:kingdom,
# dwc:phylum, dwc:class, dwc:order, dwc:family, dwc:genus (GBIF backbone
# classification of the linked taxon), skos:exactMatch / closeMatch /
# broadMatch (GBIF authority record), skos:note (unresolved names). dwc:taxonRank
# uses the project's rank scheme (lkg:taxonRankScheme: species, subspecies,
# genus, family, group — the last for informal groups such as "Limikolen").

lkg:isBird
    a owl:DatatypeProperty ;
    rdfs:label "is bird"@en , "ist Vogel"@de ;
    rdfs:comment "Extraction model's judgement whether the taxon is a bird (the diaries also mention mammals, insects, plants). Absent = not stated."@en ;
    rdfs:domain lkg:Taxon ;
    rdfs:range xsd:boolean .

lkg:matchMethod
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:matchMethodScheme ;
    rdfs:label "match method"@en , "Zuordnungsmethode"@de ;
    rdfs:comment "How the vernacular name was tied to a scientific name / GBIF record: gazetteer (project seed list), llm (the extraction model), llm+gbif (the folk-name proposer, verified in GBIF), review (a reviewer), machine-review (the machine review), unresolved — lkg:matchMethodScheme."@en ;
    rdfs:domain lkg:Taxon ;
    rdfs:range xsd:string .


lkg:gbifMatchType
    a owl:DatatypeProperty ;
    rdfs:label "GBIF match type"@en , "GBIF-Trefferart"@de ;
    rdfs:comment "GBIF backbone match type of the name: EXACT, FUZZY, HIGHERRANK. Together with lkg:matchMethod it grades the GBIF link: HIGHERRANK → skos:broadMatch; FUZZY or an LLM-mediated name (llm+gbif, machine-review) → skos:closeMatch; otherwise skos:exactMatch."@en ;
    rdfs:domain lkg:Taxon ;
    rdfs:range xsd:string .

# --- External authority links (0.6.0) --------------------------------------
# One pattern for every authority, no lkg: property needed:
#
#   <project node>  skos:exactMatch | skos:closeMatch | skos:broadMatch  <authority IRI> .
#   <authority IRI> a skos:Concept ;
#                   skos:inScheme  lkg:authority_gbif | _eunis | _geonames | _wikidata | _gnd ;
#                   skos:notation  "<the authority's own id>" ;
#                   skos:prefLabel "<its label, when known>" .
#
#   project node        authority   IRI form                                          grades used
#   lkg:Taxon           GBIF        https://www.gbif.org/species/<usageKey>            exact (EXACT match) · close (FUZZY or LLM-proposed) · broad (HIGHERRANK genus anchor)
#   habitat concept     EUNIS       http://eunis.eea.europa.eu/eunishabitats/<code>    exact · close · broad (model/reviewer judgement)
#   lkg:Place           GeoNames    https://sws.geonames.org/<id>/                     exact (OSM + GeoNames agree, or reviewed) · close (single-source name match)
#   lkg:Place           Wikidata    http://www.wikidata.org/entity/Q<n>                same grade as the place's georeference
#   lkg:Person          Wikidata    http://www.wikidata.org/entity/Q<n>                exact (reviewed) · close (unique exact-label match of a human)
#   lkg:Person          GND         https://d-nb.info/gnd/<id>                         exact (reviewer-researched)
#
# The authority schemes are declared in controlled_vocabularies.ttl. EUNIS
# classes additionally carry their skos:broader chain and rdfs:seeAlso pages.
# The SKOS mapping properties formally relate skos:Concepts: the project's
# Taxon, Place and Person nodes are read as the project's own authority
# records (index entries), as gazetteers and name authorities do; validation
# runs without RDFS inference.

# --- Weather ----------------------------------------------------------------

lkg:weatherVerbatim
    a owl:DatatypeProperty ;
    rdfs:label "weather verbatim"@en , "Wetter im Wortlaut"@de ;
    rdfs:comment "The weather passage as written; primary value of a WeatherReport."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range rdf:langString .

lkg:temperatureValue
    a owl:DatatypeProperty ;
    rdfs:label "temperature value"@en , "Temperaturwert"@de ;
    rdfs:comment "Stated number exactly as written; interpret with lkg:temperatureUnit. Never converted between scales."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range xsd:decimal .

lkg:temperatureUnit
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:temperatureUnitScheme ;
    rdfs:label "temperature unit"@en , "Temperatureinheit"@de ;
    rdfs:comment "C (Celsius), R (Réaumur), or F (Fahrenheit) — lkg:temperatureUnitScheme."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range xsd:string .

lkg:precipitation
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:precipitationScheme ;
    rdfs:label "precipitation"@en , "Niederschlag"@de ;
    rdfs:comment "Controlled term: rain, snow, sleet, hail, drizzle, fog, thunderstorm, none (lkg:precipitationScheme)."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range xsd:string .

lkg:wind
    a owl:DatatypeProperty ;
    rdfs:label "wind"@en , "Wind"@de ;
    rdfs:comment "Wind description as written; direction and strength are too varied for a vocabulary."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range rdf:langString .

lkg:skyCondition
    a owl:DatatypeProperty ;
    rdfs:seeAlso lkg:skyConditionScheme ;
    rdfs:label "sky condition"@en , "Himmelszustand"@de ;
    rdfs:comment "Controlled term: clear, partly-cloudy, overcast, variable (lkg:skyConditionScheme)."@en ;
    rdfs:domain lkg:WeatherReport ; rdfs:range xsd:string .

# --- Provenance -------------------------------------------------------------
# The extraction run is a prov:Activity (prov:startedAtTime, prov:used the
# prompt entity, prov:wasAssociatedWith the model agent); every entry record
# prov:wasGeneratedBy it and prov:wasDerivedFrom its entry.

lkg:backend
    a owl:DatatypeProperty ;
    rdfs:label "extraction backend"@en , "Extraktions-Backend"@de ;
    rdfs:comment "Backend that ran the extraction (offline test double, or an LLM provider such as google/openai). Property of the prov:SoftwareAgent of the run activity."@en ;
    rdfs:domain prov:SoftwareAgent ;
    rdfs:range xsd:string .
