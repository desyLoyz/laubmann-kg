# =============================================================
# HistOrniGraph / Laubmann Knowledge Graph
# Project Ontology  /  ontologies/laubmann.ttl
# Namespace: https://w3id.org/laubmann-kg/ontology#   (w3id folder prepared in w3id/laubmann-kg/, PR pending)
#
# v0.7.1 (2026-10-06) — cleaned image and insert regions
#   - New lkg:regionCompleteness on lkg:MultimodalRegion: "complete" or "cut off"
#     (lkg:regionCompletenessScheme), set where two scan checks agree
#     (region_check.py). Regions that only repeat an object another region of
#     the entry shows better, blank paper and fragments are no longer in the
#     graph; a region its box cut off is cut anew from its page scan.
#
# v0.7.0 (2026-09-30) — final review before the full re-extraction (prompt v4)
#   - Only what the text states: the template-driven lkg:observationRadiusMeters,
#     lkg:spatialConfidence, lkg:observationDurationMinutes and dwc:samplingProtocol
#     on Observation are removed (the viewing radius was never stated in the
#     diaries and was published as dwc:coordinateUncertaintyInMeters of a
#     settlement centroid); lkg:daylightPhase is folded into lkg:timeOfDay
#     (dawn … dusk, one scale, lkg:timeOfDayScheme); lkg:altitudeM gives way to
#     dwc:minimumElevationInMeters / dwc:maximumElevationInMeters (on the Place
#     for a stated place elevation, on the Observation for its own site);
#     lkg:matchConfidence is removed (it mixed four confidences on a shared node).
#   - Record dates: an Observation's dwc:eventDate is its own date or date range,
#     else the entry's date or interval (multi-day entries no longer give their
#     records a falsely precise start day).
#   - dwciri:recordedBy may be several persons: the diarist and the companions
#     the text says observed with him.
#   - Per-use wording stays on the use: dwc:verbatimLocality is emitted on the
#     DiaryEntry (header wording) and the Observation (own locality), no longer
#     on the shared Place; lkg:placeKind is settlement | locality | region.
#   - GeoSPARQL as specified: Place ⊑ gsp:Feature, gsp:hasGeometry → gsp:Geometry
#     with gsp:asWKT (asWKT on the Place made every place a Geometry under RDFS).
#   - Placeholders removed: transportMode "unknown" (the leg omits the mode),
#     taxonRank "unknown", placeKind "route"/"unknown", vitality "alive".
#   - Alignment: ArchivalUnit ⊑ rico:RecordResource (DiaryVolume ⊑ rico:Record;
#     page, entry and region ⊑ rico:RecordPart); TravelEvent is no dwc:Event (it
#     is never published as one). Every controlled datatype property points to
#     its scheme (rdfs:seeAlso); every concept carries skos:notation = the literal
#     used in the data. At most one WeatherReport per entry.
# v0.6.0 (2026-09-30) — one link pattern, flat vocalisations, multimodal regions
#   - External authority links are represented the same way for all five
#     authorities (GBIF, EUNIS, GeoNames, Wikidata, GND): a SKOS mapping
#     property from the project node (Taxon, Place, Person, habitat concept) to
#     the authority's IRI — skos:exactMatch (same referent, strong evidence:
#     exact GBIF match, OSM and GeoNames agree, reviewer decision), skos:closeMatch
#     (same referent, weaker evidence: fuzzy / LLM-mediated / single-source name
#     match) or skos:broadMatch (the target is broader: GBIF genus anchor, a
#     broader EUNIS class). The target is described uniformly as a skos:Concept
#     with skos:inScheme <one of lkg:authority_gbif … lkg:authority_gnd>,
#     skos:notation (the authority's own id) and, when known, skos:prefLabel.
#     owl:sameAs is no longer emitted (places and persons used it before): it
#     cannot express a graded match and would merge the external records'
#     statements into the graph under OWL reasoning.
#   - lkg:Vocalisation and lkg:hasVocalisation removed: the sound is recorded on
#     the Observation itself (lkg:callType, lkg:callTranscription, next to
#     lkg:evidenceKind lkg:evidence_auditory). No "unknown" call type
#     placeholder; singing/calling is no longer repeated as dwc:behavior.
#   - lkg:RecordDetail removed: TravelLeg (its only remaining member) is an
#     lkg:EntryRecord (dcterms:isPartOf its TravelEvent, prov:wasDerivedFrom the
#     entry, like every other extracted record).
#   - New lkg:MultimodalRegion ⊑ lkg:SourceRegion (drawings, sketch maps,
#     photographs, postcards, prints, mounted objects and inserted texts, from
#     the cleaned multimodal catalogue), linked from its entry with
#     lkg:hasMultimodalRegion ⊑ lkg:hasSourceRegion; new lkg:regionKind,
#     lkg:visibleText. An entry now links every body-text region its text was
#     read from (lkg:hasSourceRegion, several), so continuation pages are part
#     of the graph.
#   - Controlled values are literals throughout (the English prefLabel of the
#     concept in its scheme, checked with sh:in): lkg:evidenceKind is now a
#     datatype property ("auditory" instead of lkg:evidence_auditory), like
#     recordType, callType, movementKind, countQualifier … lkg:countQualifier
#     gains "maximum" ("höchstens", "bis zu"). A MultimodalRegion carries
#     schema:image (the public URL of its crop) once the images are hosted
#     (config multimodal.image_base_url). lkg:departurePlace is optional: a leg
#     to the entry's own place whose start the text does not give keeps only
#     its arrival (before, the entry place was filled in: "Kaufbeuren →
#     Kaufbeuren").
# v0.5.0 (2026-09-15) — Ziel 1 (spatial & temporal qualification):
#     lkg:spatialContext, lkg:microhabitat, lkg:relativeElevation, lkg:altitudeM,
#     lkg:observationRadiusMeters, lkg:spatialConfidence, lkg:timeOfDay,
#     lkg:daylightPhase, lkg:observationDurationMinutes; DwC hooks
#     dwc:samplingProtocol and dwc:coordinateUncertaintyInMeters on Observation.
# v0.4.3 (2026-08-19) — external linking of habitats and places: a habitat
#     concept carries at most one skos:exactMatch/closeMatch/broadMatch to a
#     EUNIS habitat class (Eionet vocabulary http://eunis.eea.europa.eu/eunishabitats/<code>,
#     cached as skos:Concept with notation, prefLabel and skos:broader chain);
#     a Place may carry owl:sameAs to its GeoNames feature and Wikidata item,
#     dwc:coordinateUncertaintyInMeters and dwc:georeferenceSources. Standard
#     terms only, no new lkg: terms.
# v0.4.2 (2026-08-19) — a DiaryVolume states the span its title page covers as
#     dcterms:temporal "YYYY-MM/YYYY-MM" (the table normalization/coverage.py
#     checks entry dates against). Standard term only, no new lkg: terms.
# v0.4.1 (2026-08-19) — entity resolution: merged spellings of taxa, persons,
#     places and habitat concepts carry skos:altLabel; an observation whose
#     written taxon name was merged into a canonical taxon keeps it as
#     dwc:verbatimIdentification. Standard terms only, no new lkg: terms.
# v0.4.0 (2026-08-18) — DwC-first, explicit hierarchy + partonomy, flattened details
#   - Three grouping superclasses carry the class hierarchy: lkg:ArchivalUnit
#     (volume/page/entry/region), lkg:EntryRecord (what the model extracts from
#     an entry: Observation, TravelEvent, WeatherReport) and lkg:RecordDetail
#     (Vocalisation, TravelLeg; removed in 0.6.0). Grouping classes are NOT materialised as
#     rdf:type in the data; the partonomy is explicit via dcterms:isPartOf /
#     dcterms:hasPart (all containment properties are sub-properties of hasPart).
#   - Renamed: ObservationEvent -> lkg:Observation (one taxon record, a
#     dwc:Occurrence; the DiaryEntry is the event), BirdCall -> lkg:Vocalisation.
#   - DwC-first: where a Darwin Core / DCTERMS / PROV term exists it is emitted
#     alone; the lkg twins are gone (individualCount, scientificName,
#     vernacularNameDE, verbatimLocality, observedBy, hasHabitat, entryDate,
#     entryDateEnd, rawText, dateNote, derivedFromEntry, hasVolume, hasPage).
#   - Flattened: behaviour notes are dwc:behavior literals, plain evidence is
#     lkg:evidenceKind concept links on the observation (ObservationEvidence,
#     BehaviourNote and the lkg:Habitat class are gone; habitat nodes stay
#     shared skos:Concepts in lkg:habitatScheme). Reserved-but-never-emitted
#     terms removed (Route, TimeEstimate, hasRoute, routePoint, routeOrder,
#     hasTimeEstimate, observedDuring, hasAnnotation, placeName).
#   - New: person roles on the mention edge (mentionsCompanion/Source/
#     Collector/CitedAuthor/Other ⊑ mentionsPerson); GBIF higher taxonomy
#     (dwc:kingdom … dwc:genus) on Taxon; gsp:asWKT on Place; several
#     WeatherReports per entry allowed.
# v0.3.0 (2026-08-17): ObservationEvent as dwc:Occurrence, Habitat as
#     skos:Concept, LLM detail properties, PROV run skeleton, w3id namespace.
# =============================================================

@prefix lkg:     <https://w3id.org/laubmann-kg/ontology#> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix dwciri:  <http://rs.tdwg.org/dwc/iri/> .
@prefix rico:    <https://www.ica.org/standards/RiC/ontology#> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gsp:     <http://www.opengis.net/ont/geosparql#> .
@prefix schema:  <https://schema.org/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix vcard:   <http://www.w3.org/2006/vcard/ns#> .

# -------------------------------------------------------------
# Ontology Declaration
# -------------------------------------------------------------
<https://w3id.org/laubmann-kg/ontology>
    a owl:Ontology ;
    dcterms:title "Laubmann Knowledge Graph Ontology"@en , "Laubmann-Wissensgraph-Ontologie"@de ;
    rdfs:label "Laubmann Knowledge Graph Ontology"@en , "Laubmann-Wissensgraph-Ontologie"@de ;
    dcterms:description "Project ontology for the HistOrniGraph knowledge graph built from the ornithological field diaries of the ornithologist Alfred Louis Laubmann (1886–1965; GND https://d-nb.info/gnd/1012394506; Bavaria, 1917–1965, 34 volumes). The HistOrniGraph project was funded by NFDI4Biodiversity. Two grouping classes structure the model: archival units (volume, page, entry, layout region — body-text regions and multimodal regions such as drawings, photographs, mounted objects and inserted texts) and entry records (what the extraction model reads out of one entry: observations as Darwin Core occurrences, travel events and their legs, weather reports); the partonomy between them is explicit (dcterms:isPartOf / hasPart). Taxa, places and persons are shared referents; habitats are NOT a class of this ontology but shared skos:Concepts of lkg:habitatScheme (see the controlled vocabularies), reached from an Observation via dwciri:habitat. Every link to an external authority — GBIF (taxa), EUNIS (habitats), GeoNames and Wikidata (places), Wikidata and GND (persons) — uses the same pattern (ontology 0.6.0): skos:exactMatch / skos:closeMatch / skos:broadMatch to the authority's IRI, which is described as a skos:Concept with skos:inScheme lkg:authority_<name>, skos:notation and skos:prefLabel. Observations carry the spatial and temporal detail the text states (vantage point, microhabitat, flight height, own elevation, qualitative time of day, clock time, own date or date range). The ontology is Darwin-Core-first: wherever a dwc/dwciri, DCTERMS, PROV-O, SKOS, GeoSPARQL or schema.org term exists, the data graph uses that term alone; lkg: terms carry only project-specific meaning (record type, count qualifier, breeding evidence, movement, evidence kind, call type, entry kind, weather, travel, mention roles, spatial/temporal qualification, region kind). Controlled values are literals: each is the skos:notation of a concept in a SKOS concept scheme of the same namespace (the property's rdfs:seeAlso); the data graph is validated with SHACL."@en ;
    rdfs:comment "Project ontology for the HistOrniGraph KG (diary entries, ornithological observations, travel, weather, persons, sources from the field journals of the ornithologist Alfred Louis Laubmann, GND https://d-nb.info/gnd/1012394506). Darwin-Core-first: standard terms are used wherever they exist; lkg: adds only project-specific terms. Grouping classes ArchivalUnit / EntryRecord plus an explicit dcterms partonomy. Habitats are skos:Concepts in lkg:habitatScheme (dwciri:habitat). External links (GBIF, EUNIS, GeoNames, Wikidata, GND) all use skos:exactMatch / closeMatch / broadMatch to an authority record in one of the lkg:authority_* schemes."@en ;
    owl:versionInfo "0.7.1" ;
    owl:versionIRI <https://w3id.org/laubmann-kg/ontology/0.7.1> ;
    owl:priorVersion <https://w3id.org/laubmann-kg/ontology/0.7.0> ;
    vann:preferredNamespacePrefix "lkg" ;
    vann:preferredNamespaceUri "https://w3id.org/laubmann-kg/ontology#" ;
    dcterms:creator _:perschl , _:wieshuber ;
    dcat:contactPoint _:perschl_contact , _:wieshuber_contact ;
    foaf:fundedBy [ a foaf:Organization ; foaf:name "NFDI4Biodiversity" ; foaf:homepage <https://www.nfdi4biodiversity.org/> ] ;   # HistOrniGraph was funded by NFDI4Biodiversity
    dcterms:publisher "HistOrniGraph / Laubmann KG Project" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights "Creative Commons Attribution 4.0 International (CC BY 4.0)"@en ;
    dcterms:issued "2026-07-22"^^xsd:date ;
    dcterms:modified "2026-10-06"^^xsd:date ;
    dcterms:source <https://github.com/Maelkolb/laubmann-kg_TP> ;
    rdfs:seeAlso <https://github.com/Maelkolb/laubmann-kg_TP> , <https://w3id.org/laubmann-kg/vocabularies> , <https://w3id.org/laubmann-kg/shapes> ;
    dcterms:subject "ornithology"@en , "field diaries"@en , "biodiversity data"@en , "Darwin Core"@en ,
                    <https://d-nb.info/gnd/1012394506> ;   # Alfred Louis Laubmann (GND)
    dcterms:language "en" , "de" .

# Authors and contact persons of the ontology (blank nodes; named here so that the
# same person is both dcterms:creator and dcat:contactPoint).
_:perschl a foaf:Person ;
    foaf:name "Tobias Perschl" ;
    foaf:mbox <mailto:Tobias.Perschl@uni-passau.de> ;
    schema:sameAs <https://orcid.org/0009-0008-7070-8705> ;
    schema:identifier <https://orcid.org/0009-0008-7070-8705> ;
    schema:affiliation [ a foaf:Organization ; foaf:name "Lehrstuhl für Computational Humanities, Universität Passau"@de , "Chair of Computational Humanities, University of Passau"@en ] .

_:wieshuber a foaf:Person ;
    foaf:name "Alois Wieshuber" ;
    foaf:mbox <mailto:alois.wieshuber@gda.bayern.de> ;
    schema:sameAs <https://orcid.org/0009-0001-7010-7968> ;
    schema:identifier <https://orcid.org/0009-0001-7010-7968> ;
    schema:affiliation [ a foaf:Organization ; foaf:name "Generaldirektion der Staatlichen Archive Bayerns"@de , "General Directorate of the State Archives of Bavaria"@en ] .

_:perschl_contact a vcard:Individual ;
    vcard:fn "Tobias Perschl" ;
    vcard:hasEmail <mailto:Tobias.Perschl@uni-passau.de> .

_:wieshuber_contact a vcard:Individual ;
