# =============================================================
# HistOrniGraph / Laubmann Knowledge Graph
# SHACL Validation Shapes  –  ontologies/shacl_shapes.ttl
# Validates instance data against ontologies/laubmann.ttl (v0.5.0)
#
# v0.5.0 (2026-09-15) — Ziel 1 (Zeit & Raum): timeOfDay, daylightPhase,
#        spatialContext, microhabitat, relativeElevation, altitudeM,
#        observationRadiusMeters, dwc:coordinateUncertaintyInMeters,
#        spatialConfidence, dwc:samplingProtocol, observationDurationMinutes.
# v0.4 – Ontologie 0.4.0: ObservationEvent -> lkg:Observation, BirdCall ->
#        lkg:Vocalisation; ObservationEvidence-, BehaviourNote-, Habitat-,
#        Route- und TimeEstimate-Shapes entfallen (Evidenz = lkg:evidenceKind-
#        Konzepte auf der Beobachtung, Verhalten = dwc:behavior-Literale,
#        Habitat = skos:Concept via dwciri:habitat). DwC-first: Shapes prüfen
#        dwc:eventDate, dwc:fieldNotes, dwc:individualCount, dwc:vernacularName,
#        dwc:scientificName, dwciri:recordedBy, dwciri:habitat statt der
#        früheren lkg-Zwillinge. Partonomie: dcterms:isPartOf ist auf jedem
#        Kind-Knoten Pflicht (EntryRecordShape ersetzt die SPARQL-Orphan-Shapes).
#        Neu: Rollen-Kanten mentionsCompanion/Source/Collector/CitedAuthor/Other,
#        GBIF-Klassifikation (dwc:kingdom … dwc:genus), gsp:asWKT, mehrere
#        WeatherReports pro Eintrag erlaubt.
# v0.3 – LLM-Detail-Properties, callTranscription optional, Habitat = Concept.
# v0.2 – sh:or (xsd:string | rdf:langString) für sprachmarkierte Literale.
#
# Usage:
#   python -m laubmann_kg.kg.shacl_validate --data <data>.ttl
#   (entspricht pyshacl -s ontologies/shacl_shapes.ttl -d <data>.ttl -f human)
#   Es wird OHNE Inferenz validiert: die Gruppierungs-Oberklassen
#   (ArchivalUnit / EntryRecord / RecordDetail) werden im Datengraph NICHT
#   materialisiert; alle Shapes zielen auf konkrete Klassen. Alle sh:in-Werte
#   spiegeln src/laubmann_kg/normalization/vocabularies.py und
#   ontologies/controlled_vocabularies.ttl.
#
# Severity-Politik: Warning für Vokabular-/Vollständigkeits-Hinweise;
#   Violation für Datentyp-/Kardinalitätsfehler, die auf Emitter-Bugs deuten.
# =============================================================

@prefix lkg:     <https://w3id.org/laubmann-kg/ontology#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix dwciri:  <http://rs.tdwg.org/dwc/iri/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gsp:     <http://www.opengis.net/ont/geosparql#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

# -------------------------------------------------------------
# Shapes graph declaration (also lets pyLODE/valpub document it)
# -------------------------------------------------------------
<https://w3id.org/laubmann-kg/shapes>
    a owl:Ontology , sh:ShapesGraph ;
    dcterms:title "Laubmann Knowledge Graph — SHACL shapes"@en ;
    dcterms:description "Validation shapes for the Laubmann KG data graph (https://w3id.org/laubmann-kg/ontology 0.5.0). Run with inference=none: shapes target the concrete classes only (grouping superclasses are not materialised in the data). Every child node must carry dcterms:isPartOf (partonomy). Vocabulary/completeness checks are sh:Warning, datatype and cardinality checks sh:Violation."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-15"^^xsd:date ;
    owl:versionInfo "0.5.0" ;
    rdfs:seeAlso <https://w3id.org/laubmann-kg/ontology> .


# =============================================================
# HINWEIS: SHACL kennt keine "Makros"; das sh:or-Pattern
# (xsd:string | rdf:langString) wird bei jeder mehrsprachigen
# String-Property wiederholt.
# =============================================================

# =============================================================
# 1. ARCHIVAL UNITS: VOLUME / PAGE / SOURCE REGION
# =============================================================

lkg:DiaryVolumeShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryVolume ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Jeder DiaryVolume benötigt ein rdfs:label (z. B. Bandnummer)." ;
        sh:severity sh:Violation ;
    ] ;
    # 0.4.2: the span the volume covers according to its title page, "YYYY-MM/YYYY-MM"
    sh:property [
        sh:path dcterms:temporal ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}-[0-9]{2}/[0-9]{4}-[0-9]{2}$" ;
        sh:message "dcterms:temporal eines DiaryVolume ist höchstens ein Intervall YYYY-MM/YYYY-MM (Titelseite)." ;
        sh:severity sh:Violation ;
    ] .

lkg:DiaryPageShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryPage ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Jede DiaryPage benötigt ein rdfs:label (z. B. Seitennummer)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryVolume ;
        sh:message "DiaryPage MUSS genau einem DiaryVolume angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] .

lkg:SourceRegionShape
    a sh:NodeShape ;
    sh:targetClass lkg:SourceRegion ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SourceRegion sollte ein rdfs:label tragen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryPage ;
        sh:message "SourceRegion gehört zu höchstens einer DiaryPage (dcterms:isPartOf)." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 2. DIARY ENTRY (the event)
# =============================================================

lkg:DiaryEntryShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryEntry ;

    # genau ein Datum: xsd:date oder DwC-Intervall "YYYY-MM-DD/YYYY-MM-DD"
    sh:property [
        sh:path dwc:eventDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$" ]
        ) ;
        sh:message "DiaryEntry muss genau ein dwc:eventDate besitzen (xsd:date oder ISO-Intervall start/end)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimEventDate ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimEventDate pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:fieldNotes ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "DiaryEntry sollte den transkribierten Eintragstext (dwc:fieldNotes) enthalten." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class lkg:DiaryPage ] [ sh:class lkg:DiaryVolume ] ) ;
        sh:message "DiaryEntry MUSS genau einer DiaryPage (oder ersatzweise einem DiaryVolume) angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:hasSourceRegion ;
        sh:maxCount 1 ;
        sh:class lkg:SourceRegion ;
        sh:message "hasSourceRegion zeigt auf höchstens eine lkg:SourceRegion." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:containsObservation ;
        sh:class lkg:Observation ;
        sh:message "containsObservation muss auf lkg:Observation-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:containsTravelEvent ;
        sh:class lkg:TravelEvent ;
        sh:message "containsTravelEvent muss auf lkg:TravelEvent-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    # mehrere Wetterberichte pro Eintrag erlaubt (Morgen/Abend)
    sh:property [
        sh:path lkg:hasWeather ;
        sh:class lkg:WeatherReport ;
        sh:message "hasWeather muss auf lkg:WeatherReport-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:entryPlace ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "entryPlace muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:entryKind ;
        sh:maxCount 1 ;
        sh:in ( "field-day" "species-digest" "retrospective" "correspondence" "other" ) ;
        sh:message "entryKind muss field-day, species-digest, retrospective, correspondence oder other sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:datePlausible ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "datePlausible muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:note ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Höchstens eine skos:note (Datumsnotiz) pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dcterms:identifier (entry_id) pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;

    # Personen: generische Kante + Rollen-Kante (Sub-Property) je Erwähnung
    sh:property [
        sh:path lkg:mentionsPerson ;
        sh:class lkg:Person ;
        sh:message "mentionsPerson muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCompanion ;
        sh:class lkg:Person ;
        sh:message "mentionsCompanion muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:mentionsSource ;
        sh:class lkg:Person ;
        sh:message "mentionsSource muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCollector ;
        sh:class lkg:Person ;
        sh:message "mentionsCollector muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCitedAuthor ;
        sh:class lkg:Person ;
        sh:message "mentionsCitedAuthor muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:mentionsOther ;
        sh:class lkg:Person ;
        sh:message "mentionsOther muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;

    sh:or (
        [ sh:path lkg:containsObservation ; sh:minCount 1 ]
        [ sh:path lkg:containsTravelEvent ; sh:minCount 1 ]
        [ sh:path lkg:hasWeather ; sh:minCount 1 ]
    ) ;
    sh:message "DiaryEntry sollte mindestens eine Observation, ein TravelEvent oder einen WeatherReport enthalten – sonst vermutlich Segmentierungsfehler." ;
    sh:severity sh:Warning .

# =============================================================
# 3. ENTRY RECORDS (Observation / TravelEvent / WeatherReport):
#    Partonomie + Provenienz — ersetzt die früheren Orphan-SPARQL-Shapes
# =============================================================

lkg:EntryRecordShape
    a sh:NodeShape ;
    sh:targetClass lkg:Observation , lkg:TravelEvent , lkg:WeatherReport ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "Jeder Eintragsdatensatz (Observation/TravelEvent/WeatherReport) MUSS genau einem DiaryEntry angehören (dcterms:isPartOf) – verhindert Orphan Nodes." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "Jeder Eintragsdatensatz MUSS prov:wasDerivedFrom seinen DiaryEntry tragen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:maxCount 1 ;
        sh:class prov:Activity ;
        sh:message "prov:wasGeneratedBy muss auf höchstens eine prov:Activity (Extraktionslauf) zeigen." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 4. OBSERVATION (dwc:Occurrence)
# =============================================================

lkg:ObservationShape
    a sh:NodeShape ;
    sh:targetClass lkg:Observation ;

    sh:property [
        sh:path lkg:observedTaxon ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Taxon ;
        sh:message "Observation MUSS genau einen lkg:observedTaxon referenzieren." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimIdentification ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Höchstens ein dwc:verbatimIdentification (Taxonname wie geschrieben, wenn per Entity-Resolution zusammengeführt)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:verbatimNotes ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Observation sollte den originalen Diariumstext (lkg:verbatimNotes) enthalten." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:observedAt ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "Observation sollte einen Ort (lkg:observedAt) referenzieren – Ziel-Knoten benötigt rdf:type lkg:Place." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:hasLocality ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "hasLocality (eigene Örtlichkeit des Nachweises) muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:verbatimLocality ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimLocality (Wortlaut der eigenen Örtlichkeit) pro Observation." ;
        sh:severity sh:Warning ;
    ] ;

    # Evidenz nur, wenn der Text sagt WIE beobachtet wurde: kein minCount.
    # Max. 4 = visual + auditory + nest + specimen. Die Konzept-IRIs leben in
    # controlled_vocabularies.ttl (nicht im Datengraph) → sh:in statt sh:class.
    sh:property [
        sh:path lkg:evidenceKind ;
        sh:maxCount 4 ;
        sh:in ( lkg:evidence_visual lkg:evidence_auditory lkg:evidence_nest lkg:evidence_specimen ) ;
        sh:message "evidenceKind: höchstens 4 Konzepte aus lkg:evidence_visual, _auditory, _nest, _specimen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:hasVocalisation ;
        sh:class lkg:Vocalisation ;
        sh:message "hasVocalisation muss auf lkg:Vocalisation-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwciri:habitat ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:message "dwciri:habitat muss auf höchstens ein skos:Concept (lkg:habitatScheme) zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:habitat ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Höchstens ein dwc:habitat-Literal pro Observation." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:behavior ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "dwc:behavior muss ein Literal sein (Verhaltensnotiz wie geschrieben)." ;
        sh:severity sh:Warning ;
    ] ;

    # 0 nur bei expliziter Abwesenheit (dwc:occurrenceStatus "absent")
    sh:property [
        sh:path dwc:individualCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "dwc:individualCount muss eine Ganzzahl >= 0 sein (0 nur bei occurrenceStatus absent)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMin ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMin muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMax ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMax muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:countQualifier ;
        sh:maxCount 1 ;
        sh:in ( "exact" "minimum" "approximate" "plural-unspecified" ) ;
        sh:message "countQualifier muss exact, minimum, approximate oder plural-unspecified sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:occurrenceStatus ;
        sh:maxCount 1 ;
        sh:in ( "present" "absent" ) ;
        sh:message "dwc:occurrenceStatus muss present oder absent sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:sex ;
        sh:maxCount 1 ;
        sh:in ( "male" "female" "mixed" ) ;
        sh:message "dwc:sex muss male, female oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:lifeStage ;
        sh:maxCount 1 ;
        sh:in ( "adult" "juvenile" "pullus" "immature" "egg" "mixed" ) ;
        sh:message "dwc:lifeStage muss adult, juvenile, pullus, immature, egg oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:vitality ;
        sh:maxCount 1 ;
        sh:in ( "alive" "dead" ) ;
        sh:message "dwc:vitality muss alive oder dead sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:breedingEvidence ;
        sh:maxCount 1 ;
        sh:in ( "confirmed" "probable" "possible" ) ;
        sh:message "breedingEvidence muss confirmed, probable oder possible sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:reproductiveCondition ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:reproductiveCondition pro Observation." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:movementKind ;
        sh:maxCount 1 ;
        sh:in ( "migrating" "passing-over" "arriving" "departing" "resting" "roosting" ) ;
        sh:message "movementKind muss migrating, passing-over, arriving, departing, resting oder roosting sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:flightDirection ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "flightDirection: höchstens ein Literal (wie geschrieben)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:identificationQualifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:identificationQualifier." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:occurrenceRemarks ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:occurrenceRemarks." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:eventDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "dwc:eventDate auf der Observation muss genau ein xsd:date sein (eigenes Datum oder Eintragsdatum)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:eventTime ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{2}:[0-9]{2}$" ;
        sh:message "dwc:eventTime muss höchstens einmal vorkommen und HH:MM sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:recordType ;
        sh:maxCount 1 ;
        sh:in ( "field-observation" "third-party-report" "literature-record" ) ;
        sh:message "recordType muss field-observation, third-party-report oder literature-record sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwciri:recordedBy ;
        sh:maxCount 1 ;
        sh:class lkg:Person ;
        sh:message "dwciri:recordedBy muss auf höchstens eine lkg:Person zeigen (Attribution wird nie erfunden)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:basisOfRecord ;
        sh:maxCount 1 ;
        sh:in ( "HumanObservation" "PreservedSpecimen" "MaterialCitation" ) ;
        sh:message "basisOfRecord muss HumanObservation, PreservedSpecimen oder MaterialCitation sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:associatedReferences ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:associatedReferences (Literaturzitat) pro Observation." ;
        sh:severity sh:Warning ;
    ] ;

    # --- Ziel 1 (v0.5.0): Zeit-, Raum- und Methodik-Qualifikation ---
    sh:property [
        sh:path lkg:timeOfDay ;
        sh:maxCount 1 ;
        sh:in ( "morning" "forenoon" "noon" "afternoon" "evening" "night" ) ;
        sh:message "lkg:timeOfDay muss morning, forenoon, noon, afternoon, evening oder night sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:daylightPhase ;
        sh:maxCount 1 ;
        sh:in ( "dawn" "day" "dusk" "night" ) ;
        sh:message "lkg:daylightPhase muss dawn, day, dusk oder night sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:spatialContext ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:microhabitat ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:relativeElevation ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:altitudeM ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:observationRadiusMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:coordinateUncertaintyInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:spatialConfidence ;
        sh:maxCount 1 ;
        sh:in ( "high" "medium" "low" "inferred" ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:samplingProtocol ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:observationDurationMinutes ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:severity sh:Violation ;
    ] .

# =============================================================
# 5. VOCALISATION (record detail of an Observation)
# =============================================================

lkg:VocalisationShape
    a sh:NodeShape ;
    sh:targetClass lkg:Vocalisation ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Observation ;
        sh:message "Vocalisation MUSS genau einer Observation angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:callType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Vocalisation MUSS genau einen callType tragen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:callType ;
        sh:in ( "song" "call" "alarm" "drumming" "unknown" ) ;
        sh:message "callType sollte bekanntes Vokabular verwenden (song, call, alarm, drumming, unknown)." ;
        sh:severity sh:Warning ;
    ] ;
    # Lautschrift nur, wenn das Tagebuch eine nennt (kein Platzhalter).
    sh:property [
        sh:path lkg:callTranscription ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Vocalisation darf höchstens eine callTranscription (Lautschrift) enthalten." ;
        sh:severity sh:Violation ;
    ] .

# =============================================================
# 6. TRAVEL EVENT / LEG
# =============================================================

lkg:TravelEventShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelEvent ;
    sh:property [
        sh:path lkg:hasLeg ;
        sh:minCount 1 ;
        sh:class lkg:TravelLeg ;
        sh:message "TravelEvent MUSS mindestens einen TravelLeg (lkg:hasLeg) besitzen." ;
        sh:severity sh:Violation ;
    ] .

lkg:TravelLegShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelLeg ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:TravelEvent ;
        sh:message "TravelLeg MUSS genau einem TravelEvent angehören (dcterms:isPartOf) – verhindert Orphan Nodes." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:departurePlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg MUSS genau einen Abfahrtsort (lkg:departurePlace) haben." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:arrivalPlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg MUSS genau einen Ankunftsort (lkg:arrivalPlace) haben." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:viaPlace ;
        sh:class lkg:Place ;
        sh:message "viaPlace muss auf lkg:Place-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:transportMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "train" "foot" "boat" "car" "carriage" "bicycle" "unknown" ) ;
        sh:message "TravelLeg sollte ein bekanntes transportMode-Vokabular verwenden." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:departureTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "departureTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:arrivalTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "arrivalTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "arrivalTime muss zeitlich nach departureTime liegen." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this lkg:departureTime ?dep .
                $this lkg:arrivalTime ?arr .
                FILTER (?arr <= ?dep)
            }
        """ ;
    ] .

# =============================================================
# 7. PLACE / HABITAT CONCEPT
# =============================================================

lkg:PlaceShape
    a sh:NodeShape ;
    sh:targetClass lkg:Place ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Place benötigt ein rdfs:label (Ortsname)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimLocality ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimLocality (Ortsname im Wortlaut) pro Place." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path geo:lat ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "geo:lat muss zwischen -90 und 90 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path geo:long ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "geo:long muss zwischen -180 und 180 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLatitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "dwc:decimalLatitude muss xsd:decimal in [-90, 90] sein (Kopie von geo:lat)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLongitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "dwc:decimalLongitude muss xsd:decimal in [-180, 180] sein (Kopie von geo:long)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsp:asWKT ;
        sh:maxCount 1 ;
        sh:datatype gsp:wktLiteral ;
        sh:pattern "^POINT\\(" ;
        sh:message "gsp:asWKT muss höchstens ein gsp:wktLiteral der Form POINT(lon lat) sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:placeKind ;
        sh:maxCount 1 ;
        sh:in ( "settlement" "locality" "region" "route" "unknown" ) ;
        sh:message "placeKind muss settlement, locality, region, route oder unknown sein." ;
        sh:severity sh:Warning ;
    ] ;
    # 0.4.3: georeference identity and precision (linking/places.py)
    sh:property [
        sh:path owl:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(https?://sws\\.geonames\\.org/[0-9]+/?|https?://www\\.wikidata\\.org/entity/Q[0-9]+)$" ;
        sh:message "owl:sameAs eines Place zeigt auf ein GeoNames-Feature (https://sws.geonames.org/<id>/) oder ein Wikidata-Item." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:coordinateUncertaintyInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "dwc:coordinateUncertaintyInMeters ist höchstens eine positive ganze Zahl (Radius des Zentroids)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:georeferenceSources ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Höchstens eine dwc:georeferenceSources-Angabe pro Place." ;
        sh:severity sh:Warning ;
    ] .

# Habitat-Knoten sind skos:Concepts in lkg:habitatScheme (keine eigene Klasse):
# adressiert über die Objekte von dwciri:habitat.
lkg:HabitatConceptShape
    a sh:NodeShape ;
    sh:targetObjectsOf dwciri:habitat ;
    sh:class skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Habitat-Konzept benötigt ein skos:prefLabel." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue lkg:habitatScheme ;
        sh:message "Habitat-Konzept muss skos:inScheme lkg:habitatScheme tragen." ;
        sh:severity sh:Warning ;
    ] ;
    # 0.4.3: at most one EUNIS class per habitat concept, as exact/close/broad match (linking/habitats.py)
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://eunis\\.eea\\.europa\\.eu/eunishabitats/" ;
        sh:message "Ein Habitat-Konzept trägt höchstens eine EUNIS-Klasse (skos:exactMatch/closeMatch/broadMatch auf http://eunis.eea.europa.eu/eunishabitats/<code>)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:message "dwciri:habitat muss auf ein skos:Concept zeigen (kein lkg:Place)." ;
    sh:severity sh:Violation .

# EUNIS classes referenced from habitat concepts: external skos:Concepts of the
# Eionet vocabulary, cached with label + notation; the hierarchy is skos:broader.
lkg:EunisConceptShape
    a sh:NodeShape ;
    sh:targetObjectsOf skos:exactMatch, skos:closeMatch, skos:broadMatch, skos:broader ;
    sh:or ( [ sh:nodeKind sh:IRI ; sh:pattern "^http://eunis\\.eea\\.europa\\.eu/eunishabitats/" ;
              sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
                            sh:message "EUNIS-Konzept benötigt genau eine skos:notation (Code)." ] ;
              sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:severity sh:Violation ;
                            sh:message "EUNIS-Konzept benötigt ein skos:prefLabel." ] ]
            [ sh:nodeKind sh:IRI ; sh:pattern "^https?://(www\\.)?(gbif\\.org|wikidata\\.org|sws\\.geonames\\.org)/" ]
            [ sh:nodeKind sh:IRI ; sh:pattern "^https://w3id\\.org/laubmann-kg/" ] ) ;
    sh:message "Ziel von skos:*Match/skos:broader ist eine EUNIS-Klasse mit Code und Label, ein GBIF/Wikidata/GeoNames-IRI oder ein Konzept des Projekts." ;
    sh:severity sh:Warning .

# =============================================================
# 8. TAXON
# =============================================================

lkg:TaxonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Taxon ;
    sh:property [
        sh:path dwc:vernacularName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Taxon MUSS genau einen deutschen Vernacular-Namen (dwc:vernacularName) haben – auch bei unbestimmter Art." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:scientificName ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:scientificName pro Taxon." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:exactMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:exactMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:closeMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:closeMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:broadMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:broadMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:taxonID ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:taxonID pro Taxon." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:taxonRank ;
        sh:maxCount 1 ;
        sh:in ( "species" "subspecies" "genus" "family" "group" "unknown" ) ;
        sh:message "dwc:taxonRank muss species, subspecies, genus, family, group oder unknown sein." ;
        sh:severity sh:Warning ;
    ] ;
    # GBIF-Klassifikation des verlinkten Taxons: je Rang höchstens ein Wert
    sh:property [ sh:path dwc:kingdom ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:kingdom." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:phylum  ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:phylum." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:class   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:class." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:order   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:order." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:family  ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:family." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:genus   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:genus." ; sh:severity sh:Warning ] ;
    sh:property [
        sh:path lkg:isBird ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "lkg:isBird muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:matchMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Taxon sollte genau eine lkg:matchMethod tragen (gazetteer, llm, llm+gbif, review, unresolved …)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:matchConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "lkg:matchConfidence muss xsd:decimal in [0, 1] sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:gbifMatchType ;
        sh:maxCount 1 ;
        sh:in ( "EXACT" "FUZZY" "HIGHERRANK" ) ;
        sh:message "lkg:gbifMatchType muss EXACT, FUZZY oder HIGHERRANK sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:or (
        [ sh:path dwc:scientificName ; sh:minCount 1 ]
        [ sh:path skos:note ; sh:minCount 1 ]
    ) ;
    sh:message "Taxon sollte entweder dwc:scientificName ODER eine skos:note zur Unsicherheit haben." ;
    sh:severity sh:Warning .

# =============================================================
# 9. WEATHER REPORT (partonomy/provenance: see EntryRecordShape)
# =============================================================

lkg:WeatherReportShape
    a sh:NodeShape ;
    sh:targetClass lkg:WeatherReport ;
    sh:property [
        sh:path lkg:weatherVerbatim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "WeatherReport MUSS genau ein weatherVerbatim tragen (Verbatim ist primär)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:temperatureValue ;
        sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minInclusive -76 ; sh:maxInclusive 140 ;
        sh:message "temperatureValue muss xsd:decimal in [-76, 140] sein (plausibler Bereich hängt von der Einheit ab: F erlaubt bis 140, C/R bis 60)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:temperatureUnit ;
        sh:maxCount 1 ;
        sh:in ( "C" "R" "F" ) ;
        sh:message "temperatureUnit muss C, R oder F sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:precipitation ;
        sh:maxCount 1 ;
        sh:in ( "rain" "snow" "sleet" "hail" "drizzle" "fog" "thunderstorm" "none" ) ;
        sh:message "precipitation muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:skyCondition ;
        sh:maxCount 1 ;
        sh:in ( "clear" "partly-cloudy" "overcast" "variable" ) ;
        sh:message "skyCondition muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:wind ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "wind sollte höchstens ein Literal sein." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 10. PERSON
# =============================================================

lkg:PersonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Person ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Person benötigt ein rdfs:label (Name)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "owl:sameAs (Wikidata) muss eine IRI sein, höchstens eine." ;
        sh:severity sh:Warning ;
    ] ;
    # Die Rolle sitzt auf der Erwähnungskante, nicht am geteilten Personenknoten.
    sh:property [
        sh:path skos:note ;
        sh:maxCount 0 ;
        sh:message "Personenrolle gehört auf die Erwähnungskante (lkg:mentionsCompanion …), nicht als skos:note an die Person (Altbestand < 0.4.0)." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 11. PROV: EXTRAKTIONSLAUF / AGENT
# =============================================================

lkg:ExtractionRunShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "prov:startedAtTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:class prov:SoftwareAgent ;
        sh:message "Der Extraktionslauf sollte einem prov:SoftwareAgent (Modell) zugeordnet sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:class prov:Entity ;
        sh:message "prov:used muss auf prov:Entity-Knoten (Prompt) zeigen." ;
        sh:severity sh:Warning ;
    ] .

lkg:SoftwareAgentShape
    a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "prov:SoftwareAgent sollte ein rdfs:label (Modellname) tragen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:backend ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "lkg:backend: höchstens ein xsd:string pro Agent." ;
        sh:severity sh:Warning ;
    ] .
