# =============================================================
# HistOrniGraph / Laubmann Knowledge Graph
# SHACL Validation Shapes  –  ontologies/shacl_shapes.ttl
# Validates instance data against ontologies/laubmann.ttl (v0.7.1)
#
# v0.7.1 (2026-10-06) — MultimodalRegion: lkg:regionCompleteness höchstens
#        einmal, "complete" oder "cut off".
# v0.7.0 (2026-09-30) — Observation: dwc:eventDate Pflicht (xsd:date oder
#        Intervall), recordType/basisOfRecord/occurrenceStatus Pflicht,
#        recordedBy mehrwertig (Diarist + Begleiter), timeOfDay mit dawn/dusk;
#        entfallen: daylightPhase, altitudeM, observationRadiusMeters,
#        coordinateUncertaintyInMeters und samplingProtocol an der Observation,
#        spatialConfidence, observationDurationMinutes, matchConfidence;
#        Höhe als dwc:minimum/maximumElevationInMeters. Place: gsp:hasGeometry
#        (GeometryShape), kein dwc:verbatimLocality mehr (steht am Eintrag bzw.
#        an der Observation), placeKind ohne route/unknown, geodeticDatum WGS84.
#        TravelLeg: transportMode optional, ohne "unknown". Höchstens ein
#        WeatherReport pro Eintrag. hasSourceRegion akzeptiert auch
#        MultimodalRegion ohne Inferenz. Einheitliche Severity: falsche
#        Zielklassen und Datentypen sind Violations, Vokabularwerte Warnings.
#
# v0.6.0 (2026-09-30) — VocalisationShape entfällt (callType/callTranscription
#        jetzt an der Observation, callType ohne "unknown"); TravelLeg trägt
#        prov:wasDerivedFrom wie jeder Eintragsdatensatz; SourceRegion ohne
#        maxCount (ein Eintrag über mehrere Seiten hat mehrere), neue
#        MultimodalRegionShape; einheitliche Normdaten-Verknüpfung: owl:sameAs
#        ist nicht mehr erlaubt, AuthorityRecordShape prüft jedes Ziel von
#        skos:exactMatch/closeMatch/broadMatch (skos:inScheme lkg:authority_*,
#        skos:notation), je Klasse sind nur die passenden Normdateien erlaubt;
#        evidenceKind ist ein Literal (sh:in), countQualifier kennt "maximum";
#        schema:image an MultimodalRegion (öffentliche Bild-URL, sobald gehostet).
# v0.5.0 (2026-09-15) — Ziel 1 (Zeit & Raum): timeOfDay, daylightPhase,
#        spatialContext, microhabitat, relativeElevation, altitudeM,
#        observationRadiusMeters, dwc:coordinateUncertaintyInMeters,
#        spatialConfidence, dwc:samplingProtocol, observationDurationMinutes.
# v0.4 – Ontologie 0.4.0: ObservationEvent -> lkg:Observation, BirdCall ->
#        lkg:Vocalisation; ObservationEvidence-, BehaviourNote-, Habitat-,
#        Route- und TimeEstimate-Shapes entfallen (Evidenz = lkg:evidenceKind-
#        Konzepte auf der Beobachtung, Verhalten = dwc:behavior-Literale,
#        Habitat = skos:Concept via dwciri:habitat). DwC-first: Shapes prüfen
#        dwc:eventDate, dwc:fieldNotes, dwc:individualCount, dwc:vernacularName,
#        dwc:scientificName, dwciri:recordedBy, dwciri:habitat statt der
#        früheren lkg-Zwillinge. Partonomie: dcterms:isPartOf ist auf jedem
#        Kind-Knoten Pflicht (EntryRecordShape ersetzt die SPARQL-Orphan-Shapes).
#        Neu: Rollen-Kanten mentionsCompanion/Source/Collector/CitedAuthor/Other,
#        GBIF-Klassifikation (dwc:kingdom … dwc:genus), gsp:asWKT, mehrere
#        WeatherReports pro Eintrag erlaubt.
# v0.3 – LLM-Detail-Properties, callTranscription optional, Habitat = Concept.
# v0.2 – sh:or (xsd:string | rdf:langString) für sprachmarkierte Literale.
#
# Usage:
#   python -m laubmann_kg.kg.shacl_validate --data <data>.ttl
#   (entspricht pyshacl -s ontologies/shacl_shapes.ttl -d <data>.ttl -f human)
#   Es wird OHNE Inferenz validiert: die Gruppierungs-Oberklassen
#   (ArchivalUnit / EntryRecord) werden im Datengraph NICHT
#   materialisiert; alle Shapes zielen auf konkrete Klassen. Alle sh:in-Werte
#   spiegeln src/laubmann_kg/normalization/vocabularies.py und
#   ontologies/controlled_vocabularies.ttl.
#
# Severity-Politik: Warning für Vokabular-/Vollständigkeits-Hinweise;
#   Violation für Datentyp-/Kardinalitätsfehler, die auf Emitter-Bugs deuten.
# =============================================================

@prefix lkg:     <https://w3id.org/laubmann-kg/ontology#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix dwciri:  <http://rs.tdwg.org/dwc/iri/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gsp:     <http://www.opengis.net/ont/geosparql#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix schema:  <https://schema.org/> .

# -------------------------------------------------------------
# Shapes graph declaration (also lets pyLODE/valpub document it)
# -------------------------------------------------------------
<https://w3id.org/laubmann-kg/shapes>
    a owl:Ontology , sh:ShapesGraph ;
    dcterms:title "Laubmann Knowledge Graph — SHACL shapes"@en ;
    dcterms:description "Validation shapes for the Laubmann KG data graph (https://w3id.org/laubmann-kg/ontology 0.7.1). Run with inference=none: shapes target the concrete classes only (grouping superclasses are not materialised in the data). Every child node must carry dcterms:isPartOf (partonomy). Vocabulary/completeness checks are sh:Warning; datatype, cardinality and target-class checks sh:Violation."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-30"^^xsd:date ;
    owl:versionInfo "0.7.1" ;
    rdfs:seeAlso <https://w3id.org/laubmann-kg/ontology> .


# =============================================================
# HINWEIS: SHACL kennt keine "Makros"; das sh:or-Pattern
# (xsd:string | rdf:langString) wird bei jeder mehrsprachigen
# String-Property wiederholt.
# =============================================================

# =============================================================
# 1. ARCHIVAL UNITS: VOLUME / PAGE / SOURCE REGION
# =============================================================

lkg:DiaryVolumeShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryVolume ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Jeder DiaryVolume benötigt ein rdfs:label (z. B. Bandnummer)." ;
        sh:severity sh:Violation ;
    ] ;
    # 0.4.2: the span the volume covers according to its title page, "YYYY-MM/YYYY-MM"
    sh:property [
        sh:path dcterms:temporal ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}-[0-9]{2}/[0-9]{4}-[0-9]{2}$" ;
        sh:message "dcterms:temporal eines DiaryVolume ist höchstens ein Intervall YYYY-MM/YYYY-MM (Titelseite)." ;
        sh:severity sh:Violation ;
    ] .

lkg:DiaryPageShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryPage ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Jede DiaryPage benötigt ein rdfs:label (z. B. Seitennummer)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryVolume ;
        sh:message "DiaryPage MUSS genau einem DiaryVolume angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] .

lkg:SourceRegionShape
    a sh:NodeShape ;
    sh:targetClass lkg:SourceRegion ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SourceRegion sollte ein rdfs:label tragen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryPage ;
        sh:message "SourceRegion gehört zu höchstens einer DiaryPage (dcterms:isPartOf)." ;
        sh:severity sh:Warning ;
    ] .

# 0.6.0: Zeichnungen, Karten, Fotos, Objekte und Texteinlagen eines Eintrags
lkg:MultimodalRegionShape
    a sh:NodeShape ;
    sh:targetClass lkg:MultimodalRegion ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryPage ;
        sh:message "MultimodalRegion MUSS genau einer DiaryPage angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:regionKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "drawing" "photograph" "map" "print" "object" "text-insert" "list" ) ;
        sh:message "MultimodalRegion trägt genau eine lkg:regionKind aus lkg:regionKindScheme." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( <http://purl.org/dc/dcmitype/StillImage> <http://purl.org/dc/dcmitype/PhysicalObject> <http://purl.org/dc/dcmitype/Text> ) ;
        sh:message "dcterms:type einer MultimodalRegion ist ein DCMI-Typ (StillImage, PhysicalObject, Text)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "schema:image ist höchstens eine öffentliche URL des Regionsbilds (multimodal.image_base_url)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:visibleText ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:regionCompleteness ;
        sh:maxCount 1 ;
        sh:in ( "complete" "cut off" ) ;
        sh:message "lkg:regionCompleteness ist höchstens einmal \"complete\" oder \"cut off\" (lkg:regionCompletenessScheme)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath lkg:hasMultimodalRegion ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "Jede MultimodalRegion hängt an genau einem DiaryEntry (lkg:hasMultimodalRegion)." ;
        sh:severity sh:Violation ;
    ] .

# =============================================================
# 2. DIARY ENTRY (the event)
# =============================================================

lkg:DiaryEntryShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryEntry ;

    # genau ein Datum: xsd:date oder DwC-Intervall "YYYY-MM-DD/YYYY-MM-DD"
    sh:property [
        sh:path dwc:eventDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$" ]
        ) ;
        sh:message "DiaryEntry muss genau ein dwc:eventDate besitzen (xsd:date oder ISO-Intervall start/end)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimEventDate ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimEventDate pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:fieldNotes ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "DiaryEntry sollte den transkribierten Eintragstext (dwc:fieldNotes) enthalten." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class lkg:DiaryPage ] [ sh:class lkg:DiaryVolume ] ) ;
        sh:message "DiaryEntry MUSS genau einer DiaryPage (oder ersatzweise einem DiaryVolume) angehören (dcterms:isPartOf)." ;
        sh:severity sh:Violation ;
    ] ;
    # 0.6.0: ein Eintrag über mehrere Seiten hat mehrere Quellregionen
    # ohne Inferenz: eine MultimodalRegion ist nicht als SourceRegion materialisiert
    sh:property [
        sh:path lkg:hasSourceRegion ;
        sh:or ( [ sh:class lkg:SourceRegion ] [ sh:class lkg:MultimodalRegion ] ) ;
        sh:message "hasSourceRegion zeigt auf lkg:SourceRegion- oder lkg:MultimodalRegion-Knoten." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimLocality ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimLocality (Ortsangabe der Kopfzeile im Wortlaut) pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:hasMultimodalRegion ;
        sh:class lkg:MultimodalRegion ;
        sh:message "hasMultimodalRegion zeigt auf lkg:MultimodalRegion-Knoten." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:containsObservation ;
        sh:class lkg:Observation ;
        sh:message "containsObservation muss auf lkg:Observation-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:containsTravelEvent ;
        sh:class lkg:TravelEvent ;
        sh:message "containsTravelEvent muss auf lkg:TravelEvent-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:hasWeather ;
        sh:maxCount 1 ;
        sh:class lkg:WeatherReport ;
        sh:message "hasWeather zeigt auf höchstens einen lkg:WeatherReport." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:entryPlace ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "entryPlace muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:entryKind ;
        sh:maxCount 1 ;
        sh:in ( "field-day" "species-digest" "retrospective" "correspondence" "other" ) ;
        sh:message "entryKind muss field-day, species-digest, retrospective, correspondence oder other sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:datePlausible ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "datePlausible muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:note ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "skos:note (Datums-, Lese- und Ablagenotizen) ist ein Literal." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dcterms:identifier (entry_id) pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;

    # Personen: generische Kante + Rollen-Kante (Sub-Property) je Erwähnung
    sh:property [
        sh:path lkg:mentionsPerson ;
        sh:class lkg:Person ;
        sh:message "mentionsPerson muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCompanion ;
        sh:class lkg:Person ;
        sh:message "mentionsCompanion muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsSource ;
        sh:class lkg:Person ;
        sh:message "mentionsSource muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCollector ;
        sh:class lkg:Person ;
        sh:message "mentionsCollector muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsCitedAuthor ;
        sh:class lkg:Person ;
        sh:message "mentionsCitedAuthor muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:mentionsOther ;
        sh:class lkg:Person ;
        sh:message "mentionsOther muss auf lkg:Person-Knoten zeigen." ;
        sh:severity sh:Violation ;
    ] ;

    sh:or (
        [ sh:path lkg:containsObservation ; sh:minCount 1 ]
        [ sh:path lkg:containsTravelEvent ; sh:minCount 1 ]
        [ sh:path lkg:hasWeather ; sh:minCount 1 ]
    ) ;
    sh:message "DiaryEntry sollte mindestens eine Observation, ein TravelEvent oder einen WeatherReport enthalten – sonst vermutlich Segmentierungsfehler." ;
    sh:severity sh:Warning .

# =============================================================
# 3. ENTRY RECORDS (Observation / TravelEvent / WeatherReport / TravelLeg):
#    Partonomie + Provenienz — ersetzt die früheren Orphan-SPARQL-Shapes
# =============================================================

# isPartOf des Eintrags: Observation, TravelEvent, WeatherReport (ein TravelLeg
# ist Teil seines TravelEvent, siehe TravelLegShape)
lkg:EntryRecordShape
    a sh:NodeShape ;
    sh:targetClass lkg:Observation , lkg:TravelEvent , lkg:WeatherReport ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "Jeder Eintragsdatensatz (Observation/TravelEvent/WeatherReport) MUSS genau einem DiaryEntry angehören (dcterms:isPartOf) – verhindert Orphan Nodes." ;
        sh:severity sh:Violation ;
    ] .

# Provenienz aller Eintragsdatensätze, TravelLeg eingeschlossen (0.6.0)
lkg:EntryRecordProvenanceShape
    a sh:NodeShape ;
    sh:targetClass lkg:Observation , lkg:TravelEvent , lkg:WeatherReport , lkg:TravelLeg ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "Jeder Eintragsdatensatz MUSS prov:wasDerivedFrom seinen DiaryEntry tragen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:maxCount 1 ;
        sh:class prov:Activity ;
        sh:message "prov:wasGeneratedBy muss auf höchstens eine prov:Activity (Extraktionslauf) zeigen." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 4. OBSERVATION (dwc:Occurrence)
# =============================================================

lkg:ObservationShape
    a sh:NodeShape ;
    sh:targetClass lkg:Observation ;

    sh:property [
        sh:path lkg:observedTaxon ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Taxon ;
        sh:message "Observation MUSS genau einen lkg:observedTaxon referenzieren." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimIdentification ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Höchstens ein dwc:verbatimIdentification (Taxonname wie geschrieben, wenn per Entity-Resolution zusammengeführt)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:verbatimNotes ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Observation sollte den originalen Diariumstext (lkg:verbatimNotes) enthalten." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:observedAt ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "Observation sollte einen Ort (lkg:observedAt) referenzieren – Ziel-Knoten benötigt rdf:type lkg:Place." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:hasLocality ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "hasLocality (eigene Örtlichkeit des Nachweises) muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:verbatimLocality ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:verbatimLocality (Wortlaut der eigenen Örtlichkeit) pro Observation." ;
        sh:severity sh:Warning ;
    ] ;

    # Evidenz nur, wenn der Text sagt WIE beobachtet wurde: kein minCount.
    # Max. 4 = visual + auditory + nest + specimen. Seit 0.6.0 ein Literal wie
    # jeder andere kontrollierte Wert (prefLabel des Konzepts in lkg:evidenceKindScheme).
    sh:property [
        sh:path lkg:evidenceKind ;
        sh:maxCount 4 ;
        sh:datatype xsd:string ;
        sh:in ( "visual" "auditory" "nest" "specimen" ) ;
        sh:message "evidenceKind: höchstens 4 Werte aus visual, auditory, nest, specimen." ;
        sh:severity sh:Warning ;
    ] ;
    # 0.6.0: was gehört wurde, steht an der Beobachtung selbst
    sh:property [
        sh:path lkg:callType ;
        sh:in ( "song" "call" "alarm" "drumming" ) ;
        sh:message "callType muss song, call, alarm oder drumming sein (kein Platzhalter \"unknown\")." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:callTranscription ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "callTranscription ist ein Literal (Lautschrift wie im Tagebuch)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwciri:habitat ;
        sh:maxCount 1 ;
        sh:class skos:Concept ;
        sh:message "dwciri:habitat muss auf höchstens ein skos:Concept (lkg:habitatScheme) zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:habitat ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Höchstens ein dwc:habitat-Literal pro Observation." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:behavior ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "dwc:behavior muss ein Literal sein (Verhaltensnotiz wie geschrieben)." ;
        sh:severity sh:Warning ;
    ] ;

    # 0 nur bei expliziter Abwesenheit (dwc:occurrenceStatus "absent")
    sh:property [
        sh:path dwc:individualCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "dwc:individualCount muss eine Ganzzahl >= 0 sein (0 nur bei occurrenceStatus absent)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMin ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMin muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMax ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMax muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:countQualifier ;
        sh:maxCount 1 ;
        sh:in ( "exact" "minimum" "maximum" "approximate" "plural-unspecified" ) ;
        sh:message "countQualifier muss exact, minimum, maximum, approximate oder plural-unspecified sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:occurrenceStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "present" "absent" ) ;
        sh:message "dwc:occurrenceStatus muss present oder absent sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:sex ;
        sh:maxCount 1 ;
        sh:in ( "male" "female" "mixed" ) ;
        sh:message "dwc:sex muss male, female oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:lifeStage ;
        sh:maxCount 1 ;
        sh:in ( "adult" "juvenile" "pullus" "immature" "egg" "mixed" ) ;
        sh:message "dwc:lifeStage muss adult, juvenile, pullus, immature, egg oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:vitality ;
        sh:maxCount 1 ;
        sh:in ( "dead" ) ;
        sh:message "dwc:vitality wird nur als dead (tot gefunden, erlegt) erfasst." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:breedingEvidence ;
        sh:maxCount 1 ;
        sh:in ( "confirmed" "probable" "possible" ) ;
        sh:message "breedingEvidence muss confirmed, probable oder possible sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:reproductiveCondition ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:reproductiveCondition pro Observation." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:movementKind ;
        sh:maxCount 1 ;
        sh:in ( "migrating" "passing-over" "arriving" "departing" "resting" "roosting" ) ;
        sh:message "movementKind muss migrating, passing-over, arriving, departing, resting oder roosting sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:flightDirection ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "flightDirection: höchstens ein Literal (wie geschrieben)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:identificationQualifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:identificationQualifier." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:occurrenceRemarks ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:occurrenceRemarks." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:eventDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$" ]
        ) ;
        sh:message "Observation muss genau ein dwc:eventDate tragen: eigenes Datum bzw. Zeitraum, sonst Datum oder Intervall des Eintrags." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:eventTime ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{2}:[0-9]{2}$" ;
        sh:message "dwc:eventTime muss höchstens einmal vorkommen und HH:MM sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:recordType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "field-observation" "third-party-report" "literature-record" ) ;
        sh:message "recordType muss field-observation, third-party-report oder literature-record sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwciri:recordedBy ;
        sh:class lkg:Person ;
        sh:message "dwciri:recordedBy zeigt auf lkg:Person-Knoten (Diarist und Begleiter bzw. Gewährsperson; Attribution wird nie erfunden)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:basisOfRecord ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "HumanObservation" "PreservedSpecimen" "MaterialCitation" ) ;
        sh:message "basisOfRecord muss HumanObservation, PreservedSpecimen oder MaterialCitation sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:associatedReferences ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:associatedReferences (Literaturzitat) pro Observation." ;
        sh:severity sh:Warning ;
    ] ;

    # --- Zeit- und Raumangaben, nur wenn der Text sie nennt (0.5.0, 0.7.0) ---
    sh:property [
        sh:path lkg:timeOfDay ;
        sh:maxCount 1 ;
        sh:in ( "dawn" "morning" "forenoon" "noon" "afternoon" "evening" "dusk" "night" ) ;
        sh:message "lkg:timeOfDay muss ein Wert aus lkg:timeOfDayScheme sein (dawn … night)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:spatialContext ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:microhabitat ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:relativeElevation ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:minimumElevationInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "dwc:minimumElevationInMeters: höchstens ein xsd:decimal (Höhe des eigenen Fundorts)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:maximumElevationInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "dwc:maximumElevationInMeters: höchstens ein xsd:decimal (Höhe des eigenen Fundorts)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:coordinateUncertaintyInMeters ;
        sh:maxCount 0 ;
        sh:message "Die Observation trägt keine eigene Koordinatenunsicherheit: sie gehört zum Ort (lkg:observedAt)." ;
        sh:severity sh:Violation ;
    ] .

# =============================================================
# 5. VOCALISATION — seit 0.6.0 keine eigene Klasse mehr (lkg:callType und
#    lkg:callTranscription an der Observation, siehe ObservationShape)
# =============================================================

# =============================================================
# 6. TRAVEL EVENT / LEG
# =============================================================

lkg:TravelEventShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelEvent ;
    sh:property [
        sh:path lkg:hasLeg ;
        sh:minCount 1 ;
        sh:class lkg:TravelLeg ;
        sh:message "TravelEvent MUSS mindestens einen TravelLeg (lkg:hasLeg) besitzen." ;
        sh:severity sh:Violation ;
    ] .

lkg:TravelLegShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelLeg ;
    sh:property [
        sh:path dcterms:isPartOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:TravelEvent ;
        sh:message "TravelLeg MUSS genau einem TravelEvent angehören (dcterms:isPartOf) – verhindert Orphan Nodes." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:departurePlace ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg hat höchstens einen Abfahrtsort (lkg:departurePlace); er fehlt, wenn der Text ihn nicht nennt (0.6.0: kein erfundener Abfahrtsort)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:arrivalPlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg MUSS genau einen Ankunftsort (lkg:arrivalPlace) haben." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:viaPlace ;
        sh:class lkg:Place ;
        sh:message "viaPlace muss auf lkg:Place-Knoten zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:transportMode ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "train" "foot" "boat" "car" "carriage" "bicycle" ) ;
        sh:message "transportMode (wenn genannt) aus lkg:transportModeScheme." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:departureTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "departureTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:arrivalTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "arrivalTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "arrivalTime muss zeitlich nach departureTime liegen." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this lkg:departureTime ?dep .
                $this lkg:arrivalTime ?arr .
                FILTER (?arr <= ?dep)
            }
        """ ;
    ] .

# =============================================================
# 7. PLACE / HABITAT CONCEPT
# =============================================================

lkg:PlaceShape
    a sh:NodeShape ;
    sh:targetClass lkg:Place ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Place benötigt ein rdfs:label (Ortsname)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:verbatimLocality ;
        sh:maxCount 0 ;
        sh:message "Der Wortlaut einer Ortsangabe gehört an den Eintrag bzw. die Observation, nicht an den geteilten Place." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path geo:lat ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "geo:lat muss zwischen -90 und 90 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path geo:long ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "geo:long muss zwischen -180 und 180 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLatitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "dwc:decimalLatitude muss xsd:decimal in [-90, 90] sein (Kopie von geo:lat)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLongitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "dwc:decimalLongitude muss xsd:decimal in [-180, 180] sein (Kopie von geo:long)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsp:hasGeometry ;
        sh:maxCount 1 ;
        sh:class gsp:Geometry ;
        sh:message "Ein Place hat höchstens eine gsp:Geometry (Punkt)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path gsp:asWKT ;
        sh:maxCount 0 ;
        sh:message "gsp:asWKT steht an der gsp:Geometry (gsp:hasGeometry), nicht am Place." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:geodeticDatum ;
        sh:maxCount 1 ;
        sh:in ( "WGS84" ) ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:minimumElevationInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:maximumElevationInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:placeKind ;
        sh:maxCount 1 ;
        sh:in ( "settlement" "locality" "region" ) ;
        sh:message "placeKind muss settlement, locality oder region sein." ;
        sh:severity sh:Warning ;
    ] ;
    # 0.6.0: Normdaten wie überall als skos:exactMatch/closeMatch (GeoNames, Wikidata; je höchstens einer)
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 0 ;
        sh:message "Seit 0.6.0 kein owl:sameAs: GeoNames/Wikidata als skos:exactMatch oder skos:closeMatch." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:node lkg:AuthorityRecordShape ;
        sh:or ( [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_geonames ] ]
                [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ] ) ;
        sh:message "Ein Place verweist nur auf GeoNames- und Wikidata-Datensätze." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_geonames ] ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Höchstens ein GeoNames-Feature pro Place." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Höchstens ein Wikidata-Item pro Place." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:coordinateUncertaintyInMeters ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "dwc:coordinateUncertaintyInMeters ist höchstens eine positive ganze Zahl (Radius des Zentroids)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:georeferenceSources ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Höchstens eine dwc:georeferenceSources-Angabe pro Place." ;
        sh:severity sh:Warning ;
    ] .

# GeoSPARQL-Punkt eines Place
lkg:GeometryShape
    a sh:NodeShape ;
    sh:targetClass gsp:Geometry ;
    sh:property [
        sh:path gsp:asWKT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype gsp:wktLiteral ;
        sh:pattern "^POINT\\(" ;
        sh:message "Eine gsp:Geometry trägt genau ein gsp:wktLiteral der Form POINT(lon lat)." ;
        sh:severity sh:Violation ;
    ] .

# Habitat-Knoten sind skos:Concepts in lkg:habitatScheme (keine eigene Klasse):
# adressiert über die Objekte von dwciri:habitat.
lkg:HabitatConceptShape
    a sh:NodeShape ;
    sh:targetObjectsOf dwciri:habitat ;
    sh:class skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "Habitat-Konzept benötigt ein skos:prefLabel." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue lkg:habitatScheme ;
        sh:message "Habitat-Konzept muss skos:inScheme lkg:habitatScheme tragen." ;
        sh:severity sh:Warning ;
    ] ;
    # at most one EUNIS class per habitat concept, as exact/close/broad match (linking/habitats.py)
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:maxCount 1 ;
        sh:node lkg:AuthorityRecordShape ;
        sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_eunis ] ;
        sh:message "Ein Habitat-Konzept trägt höchstens eine EUNIS-Klasse (skos:exactMatch/closeMatch/broadMatch, lkg:authority_eunis)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:message "dwciri:habitat muss auf ein skos:Concept zeigen (kein lkg:Place)." ;
    sh:severity sh:Violation .

# 0.6.0: jedes Ziel einer Normdaten-Verknüpfung (GBIF, EUNIS, GeoNames, Wikidata,
# GND) ist gleich beschrieben: skos:Concept in genau einem lkg:authority_*-Schema,
# mit genau einer skos:notation (ID der Normdatei) und passender IRI-Form.
lkg:AuthorityRecordShape
    a sh:NodeShape ;
    sh:targetObjectsOf skos:exactMatch , skos:closeMatch , skos:broadMatch ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( lkg:authority_gbif lkg:authority_eunis lkg:authority_geonames lkg:authority_wikidata lkg:authority_gnd ) ;
        sh:message "Normdatensatz gehört zu genau einem Normdaten-Schema (lkg:authority_gbif … lkg:authority_gnd)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:notation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Normdatensatz trägt genau eine skos:notation (ID in der Normdatei)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:or (
        [ sh:pattern "^https://www\\.gbif\\.org/species/[0-9]+$" ; sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gbif ] ]
        [ sh:pattern "^http://eunis\\.eea\\.europa\\.eu/eunishabitats/" ; sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_eunis ] ]
        [ sh:pattern "^https://sws\\.geonames\\.org/[0-9]+/$" ; sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_geonames ] ]
        [ sh:pattern "^http://www\\.wikidata\\.org/entity/Q[0-9]+$" ; sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ]
        [ sh:pattern "^https://d-nb\\.info/gnd/[0-9X-]+$" ; sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gnd ] ]
    ) ;
    sh:message "IRI-Form passt nicht zum Normdaten-Schema (GBIF /species/<key>, EUNIS /eunishabitats/<code>, GeoNames /<id>/, Wikidata /entity/Q…, GND /gnd/<id>)." ;
    sh:severity sh:Violation .

# EUNIS-Klassen: zusätzlich Label und skos:broader-Kette
lkg:EunisRecordShape
    a sh:NodeShape ;
    sh:targetObjectsOf skos:broader ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:message "EUNIS-Klasse benötigt ein skos:prefLabel." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue lkg:authority_eunis ;
        sh:message "skos:broader verbindet nur EUNIS-Klassen." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 8. TAXON
# =============================================================

lkg:TaxonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Taxon ;
    sh:property [
        sh:path dwc:vernacularName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Taxon MUSS genau einen deutschen Vernacular-Namen (dwc:vernacularName) haben – auch bei unbestimmter Art." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:scientificName ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:scientificName pro Taxon." ;
        sh:severity sh:Violation ;
    ] ;
    # 0.6.0: GBIF-Link im gemeinsamen Normdaten-Muster, höchstens einer
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 0 ;
        sh:message "Seit 0.6.0 kein owl:sameAs: Normdaten als skos:exactMatch/closeMatch/broadMatch." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gbif ] ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Höchstens ein GBIF-Backbone-Link pro Taxon." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:or ( [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gbif ] ]
                [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ] ) ;
        sh:message "Ein Taxon verweist nur auf GBIF- (und kuratierte Wikidata-)Datensätze." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:taxonID ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:taxonID pro Taxon." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:taxonRank ;
        sh:maxCount 1 ;
        sh:in ( "species" "subspecies" "genus" "family" "group" ) ;
        sh:message "dwc:taxonRank muss species, subspecies, genus, family oder group sein (lkg:taxonRankScheme)." ;
        sh:severity sh:Warning ;
    ] ;
    # GBIF-Klassifikation des verlinkten Taxons: je Rang höchstens ein Wert
    sh:property [ sh:path dwc:kingdom ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:kingdom." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:phylum  ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:phylum." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:class   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:class." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:order   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:order." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:family  ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:family." ; sh:severity sh:Warning ] ;
    sh:property [ sh:path dwc:genus   ; sh:maxCount 1 ; sh:message "Höchstens ein dwc:genus." ; sh:severity sh:Warning ] ;
    sh:property [
        sh:path lkg:isBird ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "lkg:isBird muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:matchMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "gazetteer" "llm" "llm+gbif" "review" "machine-review" "unresolved" ) ;
        sh:message "Taxon trägt genau eine lkg:matchMethod aus lkg:matchMethodScheme." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:gbifMatchType ;
        sh:maxCount 1 ;
        sh:in ( "EXACT" "FUZZY" "HIGHERRANK" ) ;
        sh:message "lkg:gbifMatchType muss EXACT, FUZZY oder HIGHERRANK sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:or (
        [ sh:path dwc:scientificName ; sh:minCount 1 ]
        [ sh:path skos:note ; sh:minCount 1 ]
    ) ;
    sh:message "Taxon sollte entweder dwc:scientificName ODER eine skos:note zur Unsicherheit haben." ;
    sh:severity sh:Warning .

# =============================================================
# 9. WEATHER REPORT (partonomy/provenance: see EntryRecordShape)
# =============================================================

lkg:WeatherReportShape
    a sh:NodeShape ;
    sh:targetClass lkg:WeatherReport ;
    sh:property [
        sh:path lkg:weatherVerbatim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "WeatherReport MUSS genau ein weatherVerbatim tragen (Verbatim ist primär)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:temperatureValue ;
        sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minInclusive -76 ; sh:maxInclusive 140 ;
        sh:message "temperatureValue muss xsd:decimal in [-76, 140] sein (plausibler Bereich hängt von der Einheit ab: F erlaubt bis 140, C/R bis 60)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:temperatureUnit ;
        sh:maxCount 1 ;
        sh:in ( "C" "R" "F" ) ;
        sh:message "temperatureUnit muss C, R oder F sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:precipitation ;
        sh:maxCount 1 ;
        sh:in ( "rain" "snow" "sleet" "hail" "drizzle" "fog" "thunderstorm" "none" ) ;
        sh:message "precipitation muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:skyCondition ;
        sh:maxCount 1 ;
        sh:in ( "clear" "partly-cloudy" "overcast" "variable" ) ;
        sh:message "skyCondition muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:wind ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "wind sollte höchstens ein Literal sein." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 10. PERSON
# =============================================================

lkg:PersonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Person ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Person benötigt ein rdfs:label (Name)." ;
        sh:severity sh:Violation ;
    ] ;
    # 0.6.0: Wikidata und GND im gemeinsamen Normdaten-Muster, je höchstens einer
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 0 ;
        sh:message "Seit 0.6.0 kein owl:sameAs: Wikidata/GND als skos:exactMatch oder skos:closeMatch." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:or ( [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ]
                [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gnd ] ] ) ;
        sh:message "Eine Person verweist nur auf Wikidata- und GND-Datensätze." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_wikidata ] ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Höchstens ein Wikidata-Item pro Person." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( skos:exactMatch skos:closeMatch skos:broadMatch ) ] ;
        sh:qualifiedValueShape [ sh:property [ sh:path skos:inScheme ; sh:hasValue lkg:authority_gnd ] ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Höchstens ein GND-Datensatz pro Person." ;
        sh:severity sh:Violation ;
    ] ;
    # Die Rolle sitzt auf der Erwähnungskante, nicht am geteilten Personenknoten.
    sh:property [
        sh:path skos:note ;
        sh:maxCount 0 ;
        sh:message "Personenrolle gehört auf die Erwähnungskante (lkg:mentionsCompanion …), nicht als skos:note an die Person (Altbestand < 0.4.0)." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 11. PROV: EXTRAKTIONSLAUF / AGENT
# =============================================================

lkg:ExtractionRunShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "prov:startedAtTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:class prov:SoftwareAgent ;
        sh:message "Der Extraktionslauf sollte einem prov:SoftwareAgent (Modell) zugeordnet sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:class prov:Entity ;
        sh:message "prov:used muss auf prov:Entity-Knoten (Prompt) zeigen." ;
        sh:severity sh:Warning ;
    ] .

lkg:SoftwareAgentShape
    a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "prov:SoftwareAgent sollte ein rdfs:label (Modellname) tragen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:backend ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "lkg:backend: höchstens ein xsd:string pro Agent." ;
        sh:severity sh:Warning ;
    ] .
